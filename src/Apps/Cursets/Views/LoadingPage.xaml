<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AjuntamentSantaMariaMartorelles.Views.LoadingPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}"
             Title="Ajuntament de Santa Maria de Martorelles">

    <Grid RowDefinitions="*,Auto,Auto,*" Padding="32">

        <Image x:Name="Escut"
               Grid.Row="1"
               Source="escut_ajuntament.png"
               HeightRequest="150"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               Opacity="0"
               Scale="0.85" />

        <VerticalStackLayout x:Name="Peu"
                             Grid.Row="2"
                             Spacing="14"
                             Margin="0,28,0,0"
                             HorizontalOptions="Center"
                             Opacity="0">
            <Label Text="Ajuntament de Santa Maria de Martorelles"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalTextAlignment="Center" />
            <ActivityIndicator IsRunning="True"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
