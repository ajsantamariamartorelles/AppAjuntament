<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:AjuntamentSantaMariaMartorelles.Converters"
             xmlns:models="clr-namespace:AjuntamentSantaMariaMartorelles.Models"
             x:Class="AjuntamentSantaMariaMartorelles.App">
    <Application.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />

            <!-- Etiqueta d'estat (models:Pill) per a BindableLayout / ContentView -->
            <DataTemplate x:Key="PillTemplate" x:DataType="models:Pill">
                <Border Style="{StaticResource Pill}" BackgroundColor="{Binding Fons}">
                    <Label Text="{Binding Text}" TextColor="{Binding TextColor}" Style="{StaticResource PillText}" />
                </Border>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
