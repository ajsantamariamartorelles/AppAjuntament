<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    hostingModel="outofprocess": IIS actua com a reverse proxy cap a Kestrel.
    Permet múltiples apps ASP.NET Core al mateix App Pool (solució per a hosting compartit).
    La alternativa "inprocess" (per defecte a .NET 6+) llança l'error 500.35 si
    hi ha més d'una app al mateix pool.

    inheritInChildApplications="false": evita que subapps/subdirectoris heretin
    aquesta configuració i entrin en conflicte.
  -->
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        hostingModel="outofprocess": cada app corre el seu propi procés Kestrel,
        IIS actua com a reverse proxy. Solució per a múltiples apps al mateix App Pool.
        processPath apunta a l'exe (self-contained win-x86, sense "dotnet").
      -->
      <aspNetCore processPath=".\AppAjuntament.exe"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
