@page "/establiments"
@using AppAjuntament.Models
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using AppAjuntament.Services
@inject IEstablimentsApiService EstablimentsService
@inject ILogger<Establiments> Logger
@inject IJSRuntime JSRuntime

<PageTitle>Establiments</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="screen-header">
                <h1 class="h3 mb-0">
                    <i class="fas fa-store me-2 text-primary"></i>
                    Cens Municipal d'Activitats i Establiments
                </h1>
                <button class="btn btn-outline-primary" @onclick="RecarregarDades" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <i class="fas fa-spinner fa-spin me-2"></i>
                    }
                    else
                    {
                        <i class="fas fa-sync-alt me-2"></i>
                    }
                    Actualitzar
                </button>
            </div>

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Carregant...</span>
                    </div>
                    <p class="mt-3">Carregant establiments...</p>
                </div>
            }
            else if (hasError)
            {
                <div class="alert alert-danger" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Error en carregar els establiments. Si us plau, proveu de nou mós tard.
                </div>
            }
            else if (establiments?.elements?.Any() == true)
            {
                <div class="row mb-3">
                    <div class="col-12 col-md-4">
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-search"></i>
                            </span>
                            <input type="text" class="form-control" placeholder="Cerca per nom comercial..." 
                                   @bind="searchTerm" @oninput="OnSearchInput" />
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <select class="form-select" @bind="sectorSeleccionat">
                            <option value="">Tots els sectors</option>
                            @foreach (var sector in sectorsDisponibles)
                            {
                                <option value="@sector">@sector</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex align-items-center">
                            <span class="badge bg-info me-2">
                                @filteredEstabliments.Count() de @establiments.elements.Count establiments
                            </span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    @foreach (var establiment in filteredEstabliments)
                    {
                        <div class="col-12 col-lg-6 col-xl-4 mb-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-header bg-light">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h5 class="card-title mb-0">
                                            @if (!string.IsNullOrEmpty(establiment.nom_comercial))
                                            {
                                                @establiment.nom_comercial
                                            }
                                            else if (!string.IsNullOrEmpty(establiment.rao_social_nom))
                                            {
                                                @establiment.rao_social_nom
                                            }
                                            else
                                            {
                                                <span class="text-muted">Sense nom comercial</span>
                                            }
                                        </h5>
                                        <span class="badge bg-secondary">
                                            @GetSectorIcon(establiment.sector_economic) @establiment.sector_economic
                                        </span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="mb-2">
                                        <small class="text-muted">
                                            <i class="fas fa-briefcase me-1"></i>
                                            <strong>Activitat:</strong> @establiment.descripcio_activitat
                                        </small>
                                    </div>

                                    @if (!string.IsNullOrEmpty(establiment.rao_social_nom) && establiment.rao_social_nom != establiment.nom_comercial)
                                    {
                                        <div class="mb-2">
                                            <small class="text-muted">
                                                <i class="fas fa-building me-1"></i>
                                                <strong>Raó social:</strong> @establiment.rao_social_nom
                                            </small>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(establiment.rao_social_nif))
                                    {
                                        <div class="mb-2">
                                            <small class="text-muted">
                                                <i class="fas fa-id-card me-1"></i>
                                                <strong>NIF:</strong> @establiment.rao_social_nif
                                            </small>
                                        </div>
                                    }

                                    @if (establiment.adreca != null && !string.IsNullOrEmpty(establiment.adreca.adreca_completa))
                                    {
                                        <div class="mb-2">
                                            <small class="text-muted">
                                                <i class="fas fa-map-marker-alt me-1"></i>
                                                <strong>Adreça:</strong> @establiment.adreca.adreca_completa
                                            </small>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(establiment.altres_activitats))
                                    {
                                        <div class="mb-2">
                                            <small class="text-muted">
                                                <i class="fas fa-plus-circle me-1"></i>
                                                <strong>Altres activitats:</strong> @establiment.altres_activitats
                                            </small>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(establiment.descripcio_nace))
                                    {
                                        <div class="mb-2">
                                            <small class="text-muted">
                                                <i class="fas fa-tag me-1"></i>
                                                <strong>CNAE:</strong> @establiment.codi_nace - @establiment.descripcio_nace
                                            </small>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(establiment.data_llic))
                                    {
                                        <div class="mb-2">
                                            <small class="text-muted">
                                                <i class="fas fa-calendar me-1"></i>
                                                <strong>Data llicència:</strong> @FormatDate(establiment.data_llic)
                                            </small>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(establiment.annex))
                                    {
                                        <div class="mb-2">
                                            <small class="text-muted">
                                                <i class="fas fa-file me-1"></i>
                                                <strong>Annex:</strong> @establiment.annex
                                            </small>
                                        </div>
                                    }
                                </div>
                                <div class="card-footer bg-white">
                                    @if (establiment.adreca != null && !string.IsNullOrEmpty(establiment.adreca.localitzacio))
                                    {
                                        <div class="btn-group w-100" role="group">
                                            <button class="btn btn-outline-primary btn-sm" 
                                                    @onclick="() => MostrarAlMapa(establiment.adreca.localitzacio)">
                                                <i class="fas fa-map me-1"></i>
                                                Veure al mapa
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-store fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">No s'han trobat establiments</h4>
                    <p class="text-muted">No hi ha establiments disponibles en aquest moment.</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private EstablimentsApiResponse? establiments;
    private bool isLoading = true;
    private bool hasError = false;
    private string searchTerm = string.Empty;
    private string sectorSeleccionat = string.Empty;

    private IEnumerable<string> sectorsDisponibles =>
        establiments?.elements?.Where(e => !string.IsNullOrEmpty(e.sector_economic))
                              .Select(e => e.sector_economic!)
                              .Distinct()
                              .OrderBy(s => s) ?? Enumerable.Empty<string>();

    private IEnumerable<EstablimentElement> filteredEstabliments =>
        establiments?.elements?.Where(e =>
            (string.IsNullOrEmpty(searchTerm) ||
             (!string.IsNullOrEmpty(e.nom_comercial) && e.nom_comercial.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
             (!string.IsNullOrEmpty(e.rao_social_nom) && e.rao_social_nom.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
             (!string.IsNullOrEmpty(e.descripcio_activitat) && e.descripcio_activitat.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))) &&
            (string.IsNullOrEmpty(sectorSeleccionat) || e.sector_economic == sectorSeleccionat)
        ) ?? Enumerable.Empty<EstablimentElement>();

    protected override async Task OnInitializedAsync()
    {
        await CarregarEstabliments();
    }

    private async Task CarregarEstabliments()
    {
        try
        {
            isLoading = true;
            hasError = false;
            StateHasChanged();

            establiments = await EstablimentsService.ObtindreEstablimentsAsync();

            if (establiments == null)
            {
                hasError = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error en carregar els establiments");
            hasError = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RecarregarDades()
    {
        await CarregarEstabliments();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }

    private string FormatDate(string dateString)
    {
        if (DateTime.TryParse(dateString, out var date))
        {
            return date.ToString("dd/MM/yyyy");
        }
        return dateString;
    }

    private string GetSectorIcon(string? sector)
    {
        return sector switch
        {
            "Activitat comercial" => "??",
            "Activitat d'hostaleria o restauració" => "???",
            "Activitat industrial" => "??",
            "Activitat de serveis" => "???",
            "Altres" => "??",
            _ => "??"
        };
    }

    private async Task MostrarAlMapa(string localitzacio)
    {
        if (!string.IsNullOrEmpty(localitzacio))
        {
            var coords = localitzacio.Split(',');
            if (coords.Length == 2)
            {
                var url = $"https://www.google.com/maps?q={coords[0]},{coords[1]}";
                await JSRuntime.InvokeVoidAsync("open", url, "_blank");
            }
        }
    }
}