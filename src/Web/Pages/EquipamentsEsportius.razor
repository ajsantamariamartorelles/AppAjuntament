@page "/dades-municipals/equipaments-esportius"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using AppAjuntament.Services
@using AppAjuntament.Models
@using Microsoft.Extensions.Options
@inject EquipamentsEsportiusService EquipamentsService
@inject IOptions<AppAjuntament.Models.AjuntamentSettings> Settings
@inject IJSRuntime JS
@inject ILogger<EquipamentsEsportius> Logger

<PageTitle>Equipaments Esportius</PageTitle>

<div class="container-fluid">
    <div class="screen-header">
        <h1 class="h3 mb-0">
            <i class="fas fa-running me-2 text-primary"></i>
            Equipaments Esportius
        </h1>
        <button class="btn btn-outline-primary" @onclick="Carregar" disabled="@isLoading">
            @if (isLoading)
            {
                <i class="fas fa-spinner fa-spin me-2"></i>
            }
            else
            {
                <i class="fas fa-sync-alt me-2"></i>
            }
            Actualitzar
        </button>
    </div>

    <p class="text-muted mb-4">
        Espais i instal·lacions esportives de @Settings.Value.NomMunicipi.
    </p>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3">Carregant equipaments...</p>
        </div>
    }
    else if (complexos.Count == 0)
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>No s'han trobat equipaments esportius per a aquest municipi.
        </div>
    }
    else
    {
        <!-- Resum -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm text-center py-3">
                    <div class="fs-3 fw-bold text-primary">@complexos.Count</div>
                    <div class="text-muted small">Complexos esportius</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm text-center py-3">
                    <div class="fs-3 fw-bold text-success">@complexos.Sum(c => c.Espais.Count)</div>
                    <div class="text-muted small">Espais esportius</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm text-center py-3">
                    <div class="fs-3 fw-bold text-info">@tipusUnics</div>
                    <div class="text-muted small">Tipus d'instal·lació</div>
                </div>
            </div>
        </div>

        <!-- Mapa -->
        @if (complexos.Any(c => c.TeCoordenades))
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-0">
                    <div id="equipaments-map" style="height:380px;border-radius:0.375rem;"></div>
                </div>
            </div>
        }

        <!-- Llista per complex -->
        @foreach (var complex in complexos)
        {
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-white border-bottom d-flex align-items-center gap-2">
                    <i class="fas fa-layer-group text-primary"></i>
                    <span class="fw-semibold">@complex.Nom</span>
                    @if (!string.IsNullOrEmpty(complex.Adreca))
                    {
                        <span class="text-muted small ms-1">— @complex.Adreca</span>
                    }
                    @if (!string.IsNullOrEmpty(complex.Telefon))
                    {
                        <span class="ms-auto text-muted small">
                            <i class="fas fa-phone me-1 opacity-50"></i>@complex.Telefon
                        </span>
                    }
                </div>
                @if (complex.Espais.Count > 0)
                {
                    <div class="card-body">
                        <div class="row g-2">
                            @foreach (var espai in complex.Espais)
                            {
                                <div class="col-12 col-md-6 col-xl-4">
                                    <div class="d-flex align-items-start gap-2 p-2 rounded" style="background:rgba(0,0,0,.02)">
                                        <i class="@espai.IconaTipus text-primary mt-1 flex-shrink-0" style="font-size:0.9rem;"></i>
                                        <div class="min-w-0">
                                            <div class="small fw-semibold">@espai.TipusInstalacio</div>
                                            @if (!string.IsNullOrEmpty(espai.Descripcio) && espai.Descripcio != espai.TipusInstalacio)
                                            {
                                                <div class="text-muted" style="font-size:0.75rem;">@espai.Descripcio</div>
                                            }
                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                @if (!string.IsNullOrEmpty(espai.SuperficieEspai) && espai.SuperficieEspai != "0")
                                                {
                                                    <span class="badge bg-light text-dark border" style="font-size:0.65rem;">@espai.SuperficieEspai m²</span>
                                                }
                                                @if (!string.IsNullOrEmpty(espai.Dimensions))
                                                {
                                                    <span class="badge bg-light text-dark border" style="font-size:0.65rem;">@espai.Dimensions</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <p class="text-muted small mt-3">
            <i class="fas fa-database me-1 opacity-50"></i>Font: Diputació de Barcelona – Equipaments esportius locals
        </p>
    }
</div>

@code {
    private List<ComplexEsportiu> complexos = [];
    private bool isLoading = true;
    private bool mapaInicialitzat = false;

    private int tipusUnics => complexos
        .SelectMany(c => c.Espais)
        .Select(e => e.TipusInstalacio)
        .Where(t => !string.IsNullOrEmpty(t))
        .Distinct()
        .Count();

    protected override async Task OnInitializedAsync() => await Carregar();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!mapaInicialitzat && !isLoading && complexos.Any(c => c.TeCoordenades))
        {
            for (int i = 0; i < 5; i++)
            {
                await Task.Delay(300);
                var ok = await JS.InvokeAsync<bool>("inicialitzarMapaEquipaments", "equipaments-map");
                if (ok)
                {
                    mapaInicialitzat = true;
                    var markers = complexos
                        .Where(c => c.TeCoordenades)
                        .Select(c => new
                        {
                            latitud = c.Lat.ToString(System.Globalization.CultureInfo.InvariantCulture),
                            longitud = c.Lng.ToString(System.Globalization.CultureInfo.InvariantCulture),
                            nom = c.Nom,
                            tipusInstalacio = string.Join(", ", c.Espais.Select(e => e.TipusInstalacio).Distinct().Take(3)),
                            horari = "",
                            web = ""
                        });
                    await JS.InvokeVoidAsync("afegirMarkersEquipaments", markers);
                    break;
                }
            }
        }
    }

    private async Task Carregar()
    {
        try
        {
            isLoading = true;
            mapaInicialitzat = false;
            StateHasChanged();
            complexos = await EquipamentsService.GetComplexosAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error carregant equipaments esportius");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
