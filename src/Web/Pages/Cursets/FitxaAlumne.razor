        [StringLength(255)] public string? Cognoms { get; set; }
        [StringLength(20)] public string? Dni { get; set; }
        [StringLength(50)] public string? Telefon { get; set; }
        [EmailAddress(ErrorMessage = "Email no vàlid.")]
        [StringLength(255)] public string? Email { get; set; }
        [StringLength(300)] public string? Adreca { get; set; }
        [StringLength(10)] public string? CodiPostal { get; set; }
        [StringLength(120)] public string? Poblacio { get; set; }
        [StringLength(1000)] public string? Notes { get; set; }
        public bool Empadronat { get; set; }
        public bool AutoritzacioTractamentSignada { get; set; }
    }
