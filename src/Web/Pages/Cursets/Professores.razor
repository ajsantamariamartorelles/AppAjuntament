@page "/cursets/professores"
@using AppAjuntament.Models.Cursets.Dto
@using AppAjuntament.Services.Cursets
@attribute [Authorize(Policy = "EditorOrAdmin")]
@inject ICursetsAuthService ProfessoraService
@inject NavigationManager Nav
@inject AppAjuntament.Services.DatabaseLoggerService DbLogger

<PageTitle>Professores de cursets</PageTitle>

<div class="screen-header mb-3">
    <h3 class="screen-title"><i class="fas fa-chalkboard-teacher me-2"></i>Professores de cursets</h3>
    <a class="btn btn-primary" href="/cursets/professores/nova">
        <i class="fas fa-plus me-2"></i>Nova professora
    </a>
</div>

<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h6 class="mb-0">Llistat (@Filtrades.Count)</h6>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <input class="form-control form-control-sm" style="width: 16rem;" placeholder="Cerca per nom o email…"
                   @bind="cerca" @bind:event="oninput" />
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="verInactives"
                       checked="@mostrarInactives" @onchange="ToggleInactives" />
                <label class="form-check-label small" for="verInactives">Mostra les de baixa</label>
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        @if (carregant)
        {
            <div class="p-4 text-center text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Carregant...</div>
        }
        else if (!Filtrades.Any())
        {
            <div class="p-4 text-center text-muted">
                @(string.IsNullOrWhiteSpace(cerca) ? "Encara no hi ha cap professora." : "Cap professora coincideix amb la cerca.")
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Email</th>
                            <th class="text-center">Cursets</th>
                            <th class="text-center">Estat</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Filtrades)
                        {
                            <tr class="@(p.Activa ? "" : "table-secondary")" style="cursor: pointer;" @onclick="() => Obrir(p.Id)">
                                <td>@p.Nom</td>
                                <td>@p.Email</td>
                                <td class="text-center">@p.NumCursets</td>
                                <td class="text-center">
                                    <span class="badge bg-@(p.Activa ? "success" : "secondary")">@(p.Activa ? "Activa" : "De baixa")</span>
                                </td>
                                <td class="text-end"><i class="fas fa-chevron-right text-muted"></i></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<ProfessoraDto> professores = new();
    private bool carregant = true;
    private bool mostrarInactives = true;
    private string cerca = string.Empty;

    private List<ProfessoraDto> Filtrades => professores
        .Where(p => string.IsNullOrWhiteSpace(cerca)
            || p.Nom.Contains(cerca, StringComparison.OrdinalIgnoreCase)
            || p.Email.Contains(cerca, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync() => await Carregar();

    private async Task Carregar()
    {
        carregant = true;
        try
        {
            professores = await ProfessoraService.LlistarProfessoresAsync(mostrarInactives);
        }
        catch (Exception ex)
        {
            await DbLogger.LogErrorAsync("Error carregant professores de cursets", ex, "Professores.Carregar");
        }
        finally
        {
            carregant = false;
        }
    }

    private async Task ToggleInactives(ChangeEventArgs e)
    {
        mostrarInactives = (bool?)e.Value ?? true;
        await Carregar();
    }

    private void Obrir(int id) => Nav.NavigateTo($"/cursets/professores/{id}");
}
