@page "/cursets/alumnes"
@using AppAjuntament.Models.Cursets.Dto
@using AppAjuntament.Services.Cursets
@attribute [Authorize(Policy = "EditorOrAdmin")]
@inject ICursetsCatalogService CatalogService
@inject NavigationManager Nav
@inject AppAjuntament.Services.DatabaseLoggerService DbLogger

<PageTitle>Alumnes de cursets</PageTitle>

<div class="screen-header mb-3">
    <h3 class="screen-title"><i class="fas fa-user-friends me-2"></i>Alumnes de cursets</h3>
    <a class="btn btn-primary" href="/cursets/alumnes/nou">
        <i class="fas fa-plus me-2"></i>Nou alumne
    </a>
</div>

<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h6 class="mb-0">Llistat (@Filtrats.Count)</h6>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <input class="form-control form-control-sm" style="width: 16rem;" placeholder="Cerca per nom o DNI…"
                   @bind="cerca" @bind:event="oninput" />
            <div class="form-check form-switch mb-0">
                <input class="form-check-input" type="checkbox" id="verInactius"
                       checked="@mostrarInactius" @onchange="ToggleInactius" />
                <label class="form-check-label small" for="verInactius">Mostra els de baixa</label>
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        @if (carregant)
        {
            <div class="p-4 text-center text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Carregant...</div>
        }
        else if (!Filtrats.Any())
        {
            <div class="p-4 text-center text-muted">
                @(string.IsNullOrWhiteSpace(cerca) ? "Encara no hi ha cap alumne." : "Cap alumne coincideix amb la cerca.")
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Contacte</th>
                            <th>Cursets</th>
                            <th class="text-center">Empadr.</th>
                            <th class="text-end">Deute</th>
                            <th class="text-center">Estat</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Filtrats)
                        {
                            <tr class="@(a.Actiu ? "" : "table-secondary")" style="cursor: pointer;"
                                @onclick="() => Obrir(a.Id)">
                                <td>
                                    @a.NomComplet
                                    @if (a.DadesLiquidacioFalten.Any())
                                    {
                                        <i class="fas fa-triangle-exclamation text-warning ms-1"
                                           title="Falta per liquidar: @string.Join(", ", a.DadesLiquidacioFalten)"></i>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(a.Dni))
                                    {
                                        <div class="small text-muted">@a.Dni</div>
                                    }
                                </td>
                                <td class="small">
                                    @if (!string.IsNullOrWhiteSpace(a.Telefon)) { <div>@a.Telefon</div> }
                                    @if (!string.IsNullOrWhiteSpace(a.Email)) { <div class="text-muted">@a.Email</div> }
                                </td>
                                <td class="small">@(string.IsNullOrEmpty(a.CursetsResum) ? "—" : a.CursetsResum)</td>
                                <td class="text-center">
                                    @if (a.Empadronat) { <i class="fas fa-check text-success"></i> }
                                </td>
                                <td class="text-end @(a.Deute > 0 ? "text-danger fw-semibold" : "text-muted")">
                                    @(a.Deute > 0 ? Eur(a.Deute) : "—")
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-@(a.Actiu ? "success" : "secondary")">@(a.Actiu ? "Actiu" : "De baixa")</span>
                                </td>
                                <td class="text-end">
                                    <i class="fas fa-chevron-right text-muted"></i>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<AlumneAdminDto> alumnes = new();
    private bool carregant = true;
    private bool mostrarInactius = true;
    private string cerca = string.Empty;

    private List<AlumneAdminDto> Filtrats => alumnes
        .Where(a => string.IsNullOrWhiteSpace(cerca)
            || a.NomComplet.Contains(cerca, StringComparison.OrdinalIgnoreCase)
            || (a.Dni?.Contains(cerca, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    protected override async Task OnInitializedAsync() => await Carregar();

    private async Task Carregar()
    {
        carregant = true;
        try
        {
            alumnes = await CatalogService.GetAlumnesAsync(mostrarInactius);
        }
        catch (Exception ex)
        {
            await DbLogger.LogErrorAsync("Error carregant alumnes", ex, "Alumnes.Carregar");
        }
        finally
        {
            carregant = false;
        }
    }

    private async Task ToggleInactius(ChangeEventArgs e)
    {
        mostrarInactius = (bool?)e.Value ?? true;
        await Carregar();
    }

    private void Obrir(int id) => Nav.NavigateTo($"/cursets/alumnes/{id}");

    private static string Eur(decimal v) =>
        v.ToString("#,##0.00", System.Globalization.CultureInfo.GetCultureInfo("ca-ES")) + " €";
}
