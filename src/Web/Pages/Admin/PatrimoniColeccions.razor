@page "/admin/patrimoni/coleccions"
@inject GestorSubvencionsContext DbContext
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using Microsoft.EntityFrameworkCore

<PageTitle>Gestió de Col·leccions Fotogràfiques</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/patrimoni/gestio">Patrimoni</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Col·leccions</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h1 class="h3 mb-0">Col·leccions Fotogràfiques</h1>
            <button @onclick="ShowCreateModal" class="btn btn-success">
                <i class="fas fa-plus me-2"></i>Nova Col·lecció
            </button>
        </div>
    </div>

    @if (ColeccionsList == null)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Carregant...</span>
            </div>
        </div>
    }
    else if (!ColeccionsList.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>No hi ha col·leccions definides.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Autor</th>
                        <th>Període</th>
                        <th>Fotos</th>
                        <th>Actiu</th>
                        <th>Accions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var col in ColeccionsList.OrderBy(c => c.Nom))
                    {
                        <tr>
                            <td>
                                <strong>@col.Nom</strong>
                                @if (!string.IsNullOrEmpty(col.Descripcio))
                                {
                                    <br /><small class="text-muted">@col.Descripcio</small>
                                }
                            </td>
                            <td>@(col.Autor ?? "—")</td>
                            <td>@(string.IsNullOrEmpty(col.PeriodeFormatat) ? "—" : col.PeriodeFormatat)</td>
                            <td><span class="badge bg-secondary">@col.Arxius.Count</span></td>
                            <td>
                                @if (col.Actiu)
                                {
                                    <span class="badge bg-success">Actiu</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactiu</span>
                                }
                            </td>
                            <td>
                                <button @onclick="() => EditColeccio(col)" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button @onclick="() => DeleteColeccio(col)" class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal crear/editar -->
<div class="modal fade @(EditingColeccio != null ? "show d-block" : "")" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@(EditingColeccio?.Id > 0 ? "Editar Col·lecció" : "Nova Col·lecció")</h5>
                <button type="button" class="btn-close" @onclick="CloseModal"></button>
            </div>
            <div class="modal-body">
                @if (EditingColeccio != null)
                {
                    <EditForm Model="EditingColeccio" OnValidSubmit="SaveColeccio">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Nom *</label>
                            <InputText @bind-Value="EditingColeccio.Nom" class="form-control" />
                            <ValidationMessage For="() => EditingColeccio.Nom" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Descripció</label>
                            <InputTextArea @bind-Value="EditingColeccio.Descripcio" class="form-control" rows="3" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Autor / Font</label>
                            <InputText @bind-Value="EditingColeccio.Autor" class="form-control" placeholder="p.ex. Arxiu Municipal, En Pepet..." />
                        </div>
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label">Any inici</label>
                                <InputNumber @bind-Value="EditingColeccio.AnyInici" class="form-control" />
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label">Any fi</label>
                                <InputNumber @bind-Value="EditingColeccio.AnyFi" class="form-control" />
                            </div>
                        </div>
                        <div class="mb-3 form-check">
                            <InputCheckbox @bind-Value="EditingColeccio.Actiu" class="form-check-input" id="chkActiuCol" />
                            <label class="form-check-label" for="chkActiuCol">Actiu</label>
                        </div>
                        <div class="modal-footer px-0 pb-0">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel·lar</button>
                            <button type="submit" class="btn btn-primary">Guardar</button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>
@if (EditingColeccio != null)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<PatrimoniColeccio>? ColeccionsList { get; set; }
    private PatrimoniColeccio? EditingColeccio { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadColeccions();
    }

    private async Task LoadColeccions()
    {
        ColeccionsList = await DbContext.PatrimoniColeccions
            .Include(c => c.Arxius)
            .OrderBy(c => c.Nom)
            .ToListAsync();
    }

    private void ShowCreateModal()
    {
        EditingColeccio = new PatrimoniColeccio { Actiu = true };
    }

    private void EditColeccio(PatrimoniColeccio col)
    {
        EditingColeccio = new PatrimoniColeccio
        {
            Id = col.Id,
            Nom = col.Nom,
            Descripcio = col.Descripcio,
            Autor = col.Autor,
            AnyInici = col.AnyInici,
            AnyFi = col.AnyFi,
            Actiu = col.Actiu
        };
    }

    private async Task SaveColeccio()
    {
        if (EditingColeccio == null) return;
        try
        {
            EditingColeccio.UpdatedAt = DateTime.Now;
            if (EditingColeccio.Id == 0)
            {
                EditingColeccio.CreatedAt = DateTime.Now;
                DbContext.PatrimoniColeccions.Add(EditingColeccio);
            }
            else
            {
                var existing = await DbContext.PatrimoniColeccions.FindAsync(EditingColeccio.Id);
                if (existing != null)
                {
                    existing.Nom = EditingColeccio.Nom;
                    existing.Descripcio = EditingColeccio.Descripcio;
                    existing.Autor = EditingColeccio.Autor;
                    existing.AnyInici = EditingColeccio.AnyInici;
                    existing.AnyFi = EditingColeccio.AnyFi;
                    existing.Actiu = EditingColeccio.Actiu;
                    existing.UpdatedAt = DateTime.Now;
                }
            }
            await DbContext.SaveChangesAsync();
            await LoadColeccions();
            CloseModal();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
    }

    private async Task DeleteColeccio(PatrimoniColeccio col)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Eliminar la col·lecció '{col.Nom}'?"))
            return;
        try
        {
            DbContext.PatrimoniColeccions.Remove(col);
            await DbContext.SaveChangesAsync();
            await LoadColeccions();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error eliminant col·lecció: {ex.Message}");
        }
    }

    private void CloseModal()
    {
        EditingColeccio = null;
    }
}
