@page "/admin/patrimoni/localitzacions"
@inject GestorSubvencionsContext DbContext
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using Microsoft.EntityFrameworkCore

<PageTitle>Gestió de Localitzacions</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/patrimoni/gestio">Patrimoni</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Localitzacions</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h1 class="h3 mb-0">Localitzacions Fotogràfiques</h1>
            <button @onclick="ShowCreateModal" class="btn btn-success">
                <i class="fas fa-plus me-2"></i>Nova Localització
            </button>
        </div>
    </div>

    @if (LocalitzacionsList == null)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Carregant...</span>
            </div>
        </div>
    }
    else if (!LocalitzacionsList.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>No hi ha localitzacions definides.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Coordenades</th>
                        <th>Fotos</th>
                        <th>Actiu</th>
                        <th>Accions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loc in LocalitzacionsList.OrderBy(l => l.Nom))
                    {
                        <tr>
                            <td>
                                <strong>@loc.Nom</strong>
                                @if (!string.IsNullOrEmpty(loc.Descripcio))
                                {
                                    <br /><small class="text-muted">@loc.Descripcio</small>
                                }
                            </td>
                            <td>
                                <small class="font-monospace text-muted">@loc.Latitud.ToString("F5"), @loc.Longitud.ToString("F5")</small>
                            </td>
                            <td><span class="badge bg-secondary">@loc.Arxius.Count</span></td>
                            <td>
                                @if (loc.Actiu)
                                {
                                    <span class="badge bg-success">Actiu</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactiu</span>
                                }
                            </td>
                            <td>
                                <button @onclick="() => EditLocalitzacio(loc)" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button @onclick="() => DeleteLocalitzacio(loc)" class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal crear/editar -->
<div class="modal fade @(EditingLocalitzacio != null ? "show d-block" : "")" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@(EditingLocalitzacio?.Id > 0 ? "Editar Localització" : "Nova Localització")</h5>
                <button type="button" class="btn-close" @onclick="CloseModal"></button>
            </div>
            <div class="modal-body">
                @if (EditingLocalitzacio != null)
                {
                    <EditForm Model="EditingLocalitzacio" OnValidSubmit="SaveLocalitzacio">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Nom *</label>
                            <InputText @bind-Value="EditingLocalitzacio.Nom" class="form-control" placeholder="p.ex. Can Gurri, Plaça Major..." />
                            <ValidationMessage For="() => EditingLocalitzacio.Nom" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Descripció</label>
                            <InputTextArea @bind-Value="EditingLocalitzacio.Descripcio" class="form-control" rows="2" />
                        </div>
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="form-label">Latitud *</label>
                                <InputNumber @bind-Value="EditingLocalitzacio.Latitud" class="form-control" />
                                <ValidationMessage For="() => EditingLocalitzacio.Latitud" />
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label">Longitud *</label>
                                <InputNumber @bind-Value="EditingLocalitzacio.Longitud" class="form-control" />
                                <ValidationMessage For="() => EditingLocalitzacio.Longitud" />
                            </div>
                        </div>
                        <div class="mb-3 form-check">
                            <InputCheckbox @bind-Value="EditingLocalitzacio.Actiu" class="form-check-input" id="chkActiuLoc" />
                            <label class="form-check-label" for="chkActiuLoc">Actiu</label>
                        </div>
                        <div class="modal-footer px-0 pb-0">
                            <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel·lar</button>
                            <button type="submit" class="btn btn-primary">Guardar</button>
                        </div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>
@if (EditingLocalitzacio != null)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<PatrimoniLocalitzacio>? LocalitzacionsList { get; set; }
    private PatrimoniLocalitzacio? EditingLocalitzacio { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadLocalitzacions();
    }

    private async Task LoadLocalitzacions()
    {
        LocalitzacionsList = await DbContext.PatrimoniLocalitzacions
            .Include(l => l.Arxius)
            .OrderBy(l => l.Nom)
            .ToListAsync();
    }

    private void ShowCreateModal()
    {
        EditingLocalitzacio = new PatrimoniLocalitzacio { Actiu = true };
    }

    private void EditLocalitzacio(PatrimoniLocalitzacio loc)
    {
        EditingLocalitzacio = new PatrimoniLocalitzacio
        {
            Id = loc.Id,
            Nom = loc.Nom,
            Descripcio = loc.Descripcio,
            Latitud = loc.Latitud,
            Longitud = loc.Longitud,
            Actiu = loc.Actiu
        };
    }

    private async Task SaveLocalitzacio()
    {
        if (EditingLocalitzacio == null) return;
        try
        {
            EditingLocalitzacio.UpdatedAt = DateTime.Now;
            if (EditingLocalitzacio.Id == 0)
            {
                EditingLocalitzacio.CreatedAt = DateTime.Now;
                DbContext.PatrimoniLocalitzacions.Add(EditingLocalitzacio);
            }
            else
            {
                var existing = await DbContext.PatrimoniLocalitzacions.FindAsync(EditingLocalitzacio.Id);
                if (existing != null)
                {
                    existing.Nom = EditingLocalitzacio.Nom;
                    existing.Descripcio = EditingLocalitzacio.Descripcio;
                    existing.Latitud = EditingLocalitzacio.Latitud;
                    existing.Longitud = EditingLocalitzacio.Longitud;
                    existing.Actiu = EditingLocalitzacio.Actiu;
                    existing.UpdatedAt = DateTime.Now;
                }
            }
            await DbContext.SaveChangesAsync();
            await LoadLocalitzacions();
            CloseModal();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
    }

    private async Task DeleteLocalitzacio(PatrimoniLocalitzacio loc)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Eliminar la localització '{loc.Nom}'?"))
            return;
        try
        {
            DbContext.PatrimoniLocalitzacions.Remove(loc);
            await DbContext.SaveChangesAsync();
            await LoadLocalitzacions();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error eliminant localització: {ex.Message}");
        }
    }

    private void CloseModal()
    {
        EditingLocalitzacio = null;
    }
}
