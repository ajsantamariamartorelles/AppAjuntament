@page "/convenis"
@using AppAjuntament.Models
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using AppAjuntament.Services
@using System.Security.Claims
@using Microsoft.Extensions.Options
@inject ConvenisApiService ConvenisService
@inject IOptions<AjuntamentSettings> AjuntamentOptions
@inject ILogger<Convenis> Logger
@inject ConvenisLocalsService _convenisLocalsService
@inject NavigationManager NavigationManager

<PageTitle>Convenis</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="screen-header">
                <h1 class="h3 mb-0">
                    <i class="fas fa-handshake me-2 text-primary"></i>
                    Convenis
                </h1>
                <div>
                    <AuthorizeView Policy="EditorOrAdmin">
                        <Authorized>
                            <button class="btn btn-success me-2" @onclick="CrearConveniLocal">
                                <i class="fas fa-plus me-1"></i>
                                Crear Conveni Local
                            </button>
                        </Authorized>
                    </AuthorizeView>
                    <button class="btn btn-outline-primary" @onclick="RecarregarDades" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <i class="fas fa-spinner fa-spin me-2"></i>
                        }
                        else
                        {
                            <i class="fas fa-sync-alt me-2"></i>
                        }
                        Actualitzar
                    </button>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Carregant...</span>
                    </div>
                    <p class="mt-3">Carregant convenis...</p>
                </div>
            }
            else if (hasError)
            {
                <div class="alert alert-danger" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Error en carregar els convenis. Si us plau, proveu de nou més tard.
                </div>
            }
            else if (convenis?.Any() == true)
            {
                <!-- Filtres -->
                <div class="row mb-3">
                    <div class="col-12 col-md-3">
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-search"></i>
                            </span>
                            <input type="text" class="form-control" placeholder="Cerca per títol..."
                                   @bind="searchTerm" @oninput="OnSearchInput" />
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <select class="form-select" @bind="selectedAny">
                            <option value="">Tots els anys</option>
                            @foreach (var any in availableAnys.OrderByDescending(a => a))
                            {
                                <option value="@any">@any</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <select class="form-select" @bind="selectedMateria">
                            <option value="">Totes les matèries</option>
                            @foreach (var materia in availableMateries.OrderBy(m => m))
                            {
                                <option value="@materia">@materia</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="d-flex align-items-center">
                            <span class="badge bg-info me-2">
                                @filteredConvenis.Count() de @convenis.Count convenis
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Taula -->
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Any</th>
                                <th>Títol</th>
                                <th>Matèria</th>
                                <th>Locals</th>
                                <th>Data Signatura</th>
                                <th>Vigent</th>
                                <th>Import Total</th>
                                <th>Accions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var conveni in filteredConvenis)
                            {
                                <tr>
                                    <td>@(conveni.ANY_SIGNATURA?.ToString() ?? "N/A")</td>
                                    <td>
                                        <div style="max-width: 300px; overflow: hidden; text-overflow: ellipsis;" title="@conveni.TITOL_CONVENI">
                                            @conveni.TITOL_CONVENI
                                        </div>
                                    </td>
                                    <td>@conveni.MATERIA</td>
                                    <td>
                                        @if (conveni.IsLocal)
                                        {
                                            <span class="badge bg-success">Sí</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No</span>
                                        }
                                    </td>
                                    <td>@(conveni.DATA_SIGNATURA?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                    <td>
                                        @if (conveni.VIGENT == "S")
                                        {
                                            <span class="badge bg-success">Sí</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No</span>
                                        }
                                    </td>
                                    <td>@(conveni.TOTAL_APORTACIONS_PREVISTES?.ToString("N2") ?? "N/A") €</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(conveni.PDF_CONVENI))
                                        {
                                            <a href="@conveni.PDF_CONVENI" target="_blank" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-file-pdf me-1"></i>
                                                PDF
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-handshake fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">No s'han trobat convenis</h4>
                    <p class="text-muted">No hi ha convenis disponibles en aquest moment.</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<Conveni>? convenis;
    private List<ConvenisLocals>? convenisLocals;
    private bool isLoading = true;
    private bool hasError = false;
    private string searchTerm = string.Empty;
    private string selectedAny = string.Empty;
    private string selectedMateria = string.Empty;

    private IEnumerable<Conveni> filteredConvenis =>
        convenis?.Where(c =>
            (string.IsNullOrEmpty(searchTerm) ||
             c.TITOL_CONVENI?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true) &&
            (string.IsNullOrEmpty(selectedAny) || c.ANY_SIGNATURA?.ToString() == selectedAny) &&
            (string.IsNullOrEmpty(selectedMateria) || c.MATERIA == selectedMateria)
        ) ?? Enumerable.Empty<Conveni>();

    private IEnumerable<int> availableAnys =>
        convenis?.Where(c => c.ANY_SIGNATURA.HasValue).Select(c => (int)c.ANY_SIGNATURA!).Distinct().OrderByDescending(a => a) ?? Enumerable.Empty<int>();

    private IEnumerable<string> availableMateries =>
        convenis?.Select(c => c.MATERIA).Where(m => !string.IsNullOrEmpty(m)).Select(m => m!).Distinct().OrderBy(m => m) ?? Enumerable.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        await CarregarConvenis();
    }

    private async Task CarregarConvenis()
    {
        try
        {
            isLoading = true;
            hasError = false;
            StateHasChanged();

            var codiEns = AjuntamentOptions.Value.CodiEns?.Trim();
            if (string.IsNullOrWhiteSpace(codiEns))
            {
                Logger.LogError("No s'ha configurat Ajuntament:CodiEns per a la consulta de convenis.");
                hasError = true;
                return;
            }

            convenis = await ConvenisService.GetConvenisAsync(codiEns) ?? new List<Conveni>();
            convenisLocals = await _convenisLocalsService.GetAllConvenisLocalsAsync();

            // Combinar amb els convenis locals
            if (convenisLocals != null)
            {
                convenis.AddRange(convenisLocals);
            }

            if (convenis == null)
            {
                hasError = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error en carregar els convenis");
            hasError = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RecarregarDades()
    {
        await CarregarConvenis();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }

    private void CrearConveniLocal()
    {
        NavigationManager.NavigateTo("/crear-conveni-local");
    }
}
