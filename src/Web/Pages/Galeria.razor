@page "/galeria"
@using AppAjuntament.Models
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using AppAjuntament.Services
@inject IPatrimoniService PatrimoniService
@inject ICatalogService CatalogService
@inject NavigationManager Navigation

<PageTitle>Galeria del Patrimoni</PageTitle>

<style>
    .galeria-header {
        background: linear-gradient(135deg, #2E8B57, #228B22);
        color: white;
        padding: 40px 0;
        margin-bottom: 30px;
        text-align: center;
    }
    
    .galeria-title {
        font-size: 2.5rem;
        font-weight: bold;
        margin-bottom: 15px;
    }
    
    .galeria-subtitle {
        font-size: 1.1rem;
        opacity: 0.9;
    }
    
    .filters-section {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 30px;
    }
    
    .filter-group {
        margin-bottom: 15px;
    }
    
    .filter-label {
        font-weight: bold;
        margin-bottom: 5px;
        display: block;
    }
    
    .patrimoni-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 25px;
        margin-bottom: 40px;
    }
    
    .patrimoni-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
    }
    
    .patrimoni-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }
    
    .patrimoni-image {
        width: 100%;
        height: 200px;
        object-fit: cover;
        background: linear-gradient(45deg, #f0f0f0, #e0e0e0);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        color: #999;
    }
    
    .patrimoni-content {
        padding: 20px;
    }
    
    .patrimoni-type {
        background: #2E8B57;
        color: white;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        display: inline-block;
        margin-bottom: 10px;
    }
    
    .patrimoni-title {
        font-size: 1.2rem;
        font-weight: bold;
        margin-bottom: 10px;
        color: #333;
    }
    
    .patrimoni-description {
        color: #666;
        font-size: 0.9rem;
        line-height: 1.4;
        margin-bottom: 15px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .patrimoni-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.8rem;
        color: #999;
    }
    
    .patrimoni-location {
        display: flex;
        align-items: center;
        gap: 5px;
    }
    
    .patrimoni-status {
        padding: 2px 8px;
        border-radius: 10px;
        font-size: 0.7rem;
        font-weight: bold;
    }
    
    .status-bo { background: #d4edda; color: #155724; }
    .status-regular { background: #fff3cd; color: #856404; }
    .status-dolent { background: #f8d7da; color: #721c24; }
    
    .loading-spinner {
        text-align: center;
        padding: 60px;
    }
    
    .no-results {
        text-align: center;
        padding: 60px;
        color: #666;
    }
    
    .results-info {
        text-align: center;
        margin-bottom: 20px;
        color: #666;
        font-style: italic;
    }
    
    .btn-filter {
        background: #2E8B57;
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 20px;
        margin-right: 10px;
    }
    
    .btn-filter:hover {
        background: #228B22;
        color: white;
    }
    
    .btn-clear {
        background: #6c757d;
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 20px;
    }
    
    .btn-clear:hover {
        background: #5a6268;
        color: white;
    }
</style>

<!-- Header -->
<div class="galeria-header">
    <div class="container">
        <h1 class="galeria-title">Galeria del Patrimoni</h1>
        <p class="galeria-subtitle">Explora tots els elements del nostre patrimoni cultural</p>
    </div>
</div>

<div class="container">
    @if (carregant)
    {
        <div class="loading-spinner">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Carregant...</span>
            </div>
            <p class="mt-3 text-muted">Carregant patrimoni cultural...</p>
        </div>
    }
    else
    {
        <!-- Filtres -->
        <div class="filters-section">
            <h5>Filtres de cerca</h5>
            <div class="row">
                <div class="col-md-4">
                    <div class="filter-group">
                        <label class="filter-label">Tipus de Patrimoni</label>
                        <select class="form-select" @bind="tipusSeleccionat" @bind:after="AplicarFiltres">
                            <option value="">Tots els tipus</option>
                            @if (tipusPatrimoni != null)
                            {
                                @foreach (var tipus in tipusPatrimoni)
                                {
                                    <option value="@tipus.Id">@tipus.Nom</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="filter-group">
                        <label class="filter-label">Ubicació</label>
                        <select class="form-select" @bind="ubicacioSeleccionada" @bind:after="AplicarFiltres">
                            <option value="">Totes les ubicacions</option>
                            @if (ubicacions != null)
                            {
                                @foreach (var ubicacio in ubicacions)
                                {
                                    <option value="@ubicacio.Id">@ubicacio.Nom</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="filter-group">
                        <label class="filter-label">Estat de Conservació</label>
                        <select class="form-select" @bind="estatSeleccionat" @bind:after="AplicarFiltres">
                            <option value="">Tots els estats</option>
                            @if (estats != null)
                            {
                                @foreach (var estat in estats)
                                {
                                    <option value="@estat.Id">@estat.Nom</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="mt-3">
                <button class="btn btn-filter" @onclick="AplicarFiltres">
                    <i class="bi bi-funnel"></i> Aplicar Filtres
                </button>
                <button class="btn btn-clear" @onclick="NetejrarFiltres">
                    <i class="bi bi-x-circle"></i> Netejar Filtres
                </button>
            </div>
        </div>

        <!-- Informació de resultats -->
        @if (patrimoniMostrat != null)
        {
            <div class="results-info">
                Mostrant @patrimoniMostrat.Count() de @totalElements elements
            </div>
        }

        <!-- Grid de patrimoni -->
        @if (patrimoniMostrat != null && patrimoniMostrat.Any())
        {
            <div class="patrimoni-grid">
                @foreach (var element in patrimoniMostrat)
                {
                    var arxiuImatge = element.Arxius?.FirstOrDefault(a =>
                        a.EsImatge &&
                        a.VisiblePublic &&
                        a.Actiu &&
                        !string.IsNullOrWhiteSpace(a.UrlMinio));

                    <div class="patrimoni-card" @onclick="() => MostrarDetall(element.Id)">
                        <div class="patrimoni-image">
                            @if (arxiuImatge != null)
                            {
                                <img src="@arxiuImatge.UrlMinio" alt="@element.Nom" class="patrimoni-image" />
                            }
                            else
                            {
                                <i class="bi bi-image"></i>
                            }
                        </div>
                        <div class="patrimoni-content">
                            @if (element.TipusPatrimoni != null)
                            {
                                <span class="patrimoni-type">@element.TipusPatrimoni.Nom</span>
                            }
                            <h6 class="patrimoni-title">@element.Nom</h6>
                            @if (!string.IsNullOrEmpty(element.DescripcioBreu))
                            {
                                <p class="patrimoni-description">@element.DescripcioBreu</p>
                            }
                            <div class="patrimoni-meta">
                                <div class="patrimoni-location">
                                    <i class="bi bi-geo-alt"></i>
                                    @if (element.Ubicacio != null)
                                    {
                                        <span>@element.Ubicacio.Nom</span>
                                    }
                                    else
                                    {
                                        <span>Ubicació no especificada</span>
                                    }
                                </div>
                                @if (element.EstatConservacio != null)
                                {
                                    <span class="patrimoni-status status-@GetStatusClass(element.EstatConservacio.Nom)">
                                        @element.EstatConservacio.Nom
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="no-results">
                <i class="bi bi-search" style="font-size: 3rem; color: #ccc; margin-bottom: 20px;"></i>
                <h5>No s'han trobat elements</h5>
                <p>Prova a modificar els filtres de cerca per obtenir resultats diferents.</p>
            </div>
        }
    }
</div>

@code {
    private bool carregant = true;
    private IEnumerable<Patrimoni>? totPatrimoni;
    private IEnumerable<Patrimoni>? patrimoniMostrat;
    private IEnumerable<TipusPatrimoni>? tipusPatrimoni;
    private IEnumerable<Ubicacio>? ubicacions;
    private IEnumerable<EstatConservacio>? estats;
    
    private string tipusSeleccionat = "";
    private string ubicacioSeleccionada = "";
    private string estatSeleccionat = "";
    private int totalElements = 0;

    protected override async Task OnInitializedAsync()
    {
        await CarregarDades();
    }

    private async Task CarregarDades()
    {
        carregant = true;
        StateHasChanged();

        try
        {
            // Carregar tots els elements
            totPatrimoni = await PatrimoniService.GetAllAsync();
            totalElements = totPatrimoni?.Count() ?? 0;
            
            // Carregar dades per als filtres
            tipusPatrimoni = await CatalogService.GetTipusPatrimoniAsync();
            ubicacions = await CatalogService.GetUbicacionsAsync();
            estats = await CatalogService.GetEstatsConservacioAsync();

            // Mostrar tots els elements inicialment
            patrimoniMostrat = totPatrimoni?.Where(p => p.Actiu);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error carregant dades: {ex.Message}");
        }
        finally
        {
            carregant = false;
            StateHasChanged();
        }
    }

    private async Task AplicarFiltres()
    {
        if (totPatrimoni == null) return;

        patrimoniMostrat = totPatrimoni.Where(p => p.Actiu);

        // Filtrar per tipus
        if (!string.IsNullOrEmpty(tipusSeleccionat) && int.TryParse(tipusSeleccionat, out int tipusId))
        {
            patrimoniMostrat = patrimoniMostrat.Where(p => p.TipusPatrimoniId == tipusId);
        }

        // Filtrar per ubicació
        if (!string.IsNullOrEmpty(ubicacioSeleccionada) && int.TryParse(ubicacioSeleccionada, out int ubicacioId))
        {
            patrimoniMostrat = patrimoniMostrat.Where(p => p.UbicacioId == ubicacioId);
        }

        // Filtrar per estat
        if (!string.IsNullOrEmpty(estatSeleccionat) && int.TryParse(estatSeleccionat, out int estatId))
        {
            patrimoniMostrat = patrimoniMostrat.Where(p => p.EstatConservacioId == estatId);
        }

        StateHasChanged();
    }

    private async Task NetejrarFiltres()
    {
        tipusSeleccionat = "";
        ubicacioSeleccionada = "";
        estatSeleccionat = "";
        
        if (totPatrimoni != null)
        {
            patrimoniMostrat = totPatrimoni.Where(p => p.Actiu);
        }
        
        StateHasChanged();
    }

    private void MostrarDetall(int id)
    {
        Navigation.NavigateTo($"/detall/{id}");
    }

    private string GetStatusClass(string? estat)
    {
        return estat?.ToLower() switch
        {
            "bo" or "molt bo" or "excel·lent" => "bo",
            "regular" or "acceptable" => "regular",
            "dolent" or "molt dolent" or "ruïnós" => "dolent",
            _ => "regular"
        };
    }
}