@page "/transparencia"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using AppAjuntament.Services
@using AppAjuntament.Models
@using Microsoft.Extensions.Options
@inject TransparenciaService TransparenciaService
@inject CarrecsElectesService CarrecsElectesService
@inject TecnicsMunicipalsService TecnicsMunicipalsService
@inject IOptions<AppAjuntament.Models.AjuntamentSettings> Settings
@inject ILogger<Transparencia> Logger

<PageTitle>Transparència Municipal</PageTitle>

<div class="container-fluid">
    <div class="screen-header">
        <h1 class="h3 mb-0">
            <i class="fas fa-balance-scale me-2 text-primary"></i>
            Transparència Municipal
        </h1>
        <button class="btn btn-outline-primary" @onclick="Carregar" disabled="@isLoading">
            @if (isLoading)
            {
                <i class="fas fa-spinner fa-spin me-2"></i>
            }
            else
            {
                <i class="fas fa-sync-alt me-2"></i>
            }
            Actualitzar
        </button>
    </div>

    <p class="text-muted mb-4">
        Indicadors públics de @Settings.Value.NomMunicipi proporcionats per la Diputació de Barcelona i altres fonts obertes.
    </p>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3">Carregant indicadors...</p>
        </div>
    }
    else
    {
        <!-- Govern Municipal -->
        <h5 class="text-muted text-uppercase fw-semibold mb-3" style="font-size:0.8rem;letter-spacing:.08em;">
            <i class="fas fa-users me-2"></i>Govern Municipal
        </h5>
        @if (carrecsElectes.Count > 0)
        {
            <div class="row g-3 mb-5">
                @foreach (var carrec in carrecsElectes)
                {
                    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width:44px;height:44px;background:var(--bs-@(carrec.ColorCarrec)-bg-subtle,rgba(var(--bs-@(carrec.ColorCarrec)-rgb),.15))">
                                        <i class="@carrec.IconaCarrec text-@carrec.ColorCarrec"></i>
                                    </div>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="fw-semibold text-truncate">@carrec.NomComplet</div>
                                        <div class="text-muted small">@carrec.Carrec</div>
                                        @if (!string.IsNullOrEmpty(carrec.Sigles))
                                        {
                                            <span class="badge bg-light text-dark border mt-1" style="font-size:0.7rem;">@carrec.Sigles</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <p class="text-muted small mb-5">
                <i class="fas fa-database me-1 opacity-50"></i>Font: Diputació de Barcelona – Càrrecs electes
            </p>
        }
        else
        {
            <div class="row g-3 mb-5">
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <div class="card border-dashed h-100 text-center text-muted py-4" style="border:2px dashed #dee2e6;">
                        <i class="fas fa-users fa-2x mb-2 opacity-25"></i>
                        <small>Sense dades</small>
                    </div>
                </div>
            </div>
        }

        <!-- Infraestructures i Mobilitat -->
        <h5 class="text-muted text-uppercase fw-semibold mb-3" style="font-size:0.8rem;letter-spacing:.08em;">
            <i class="fas fa-road me-2"></i>Infraestructures i Mobilitat
        </h5>
        <div class="row g-3 mb-5">
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <IndicadorCard Indicador="plaAccessibilitat" />
            </div>
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <IndicadorCard Indicador="mobilitatSostenible" />
            </div>
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <IndicadorCard Indicador="aforamentsImd" />
            </div>
        </div>

        <!-- Medi Ambient -->
        <h5 class="text-muted text-uppercase fw-semibold mb-3" style="font-size:0.8rem;letter-spacing:.08em;">
            <i class="fas fa-leaf me-2"></i>Medi Ambient
        </h5>
        <div class="row g-3 mb-5">
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <IndicadorCard Indicador="pacteAlcaldes" />
            </div>
        </div>

        <!-- Administració -->
        <h5 class="text-muted text-uppercase fw-semibold mb-3" style="font-size:0.8rem;letter-spacing:.08em;">
            <i class="fas fa-landmark me-2"></i>Administració
        </h5>
        <div class="row g-3 mb-5">
            @foreach (var tecnic in tecnics)
            {
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <div class="d-flex align-items-start gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width:44px;height:44px;background:rgba(var(--bs-info-rgb),.15)">
                                    <i class="fas fa-user-shield text-info"></i>
                                </div>
                                <div class="flex-grow-1 min-w-0">
                                    <div class="fw-semibold text-truncate">@tecnic.NomComplet</div>
                                    <div class="text-muted small">@tecnic.Carrec</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            @if (tecnics.Count == 0)
            {
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <div class="card border-dashed h-100 text-center text-muted py-4" style="border:2px dashed #dee2e6;">
                        <i class="fas fa-plus fa-2x mb-2 opacity-25"></i>
                        <small>Properament</small>
                    </div>
                </div>
            }
        </div>
        @if (tecnics.Count > 0)
        {
            <p class="text-muted small mb-5">
                <i class="fas fa-database me-1 opacity-50"></i>Font: Diputació de Barcelona – Tècnics municipals
            </p>
        }
    }
</div>

@code {
    private IndicadorTransparencia plaAccessibilitat = new();
    private IndicadorTransparencia mobilitatSostenible = new();
    private IndicadorTransparencia pacteAlcaldes = new();
    private IndicadorTransparencia aforamentsImd = new();
    private List<CarrecElecte> carrecsElectes = new();
    private List<TecnicMunicipal> tecnics = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync() => await Carregar();

    private async Task Carregar()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var indicadorsTask = Task.WhenAll(
                TransparenciaService.GetPlaAccessibilitatAsync(),
                TransparenciaService.GetMobilitatSostenibleAsync(),
                TransparenciaService.GetPacteAlcaldesAsync(),
                TransparenciaService.GetAforamentsIMDAsync()
            );
            var carrecsTask = CarrecsElectesService.GetCarrecsElectesAsync();
            var tecnicsTask = TecnicsMunicipalsService.GetTecnicsAsync();

            await Task.WhenAll(indicadorsTask, carrecsTask, tecnicsTask);

            plaAccessibilitat = indicadorsTask.Result[0];
            mobilitatSostenible = indicadorsTask.Result[1];
            pacteAlcaldes = indicadorsTask.Result[2];
            aforamentsImd = indicadorsTask.Result[3];
            carrecsElectes = carrecsTask.Result;
            tecnics = tecnicsTask.Result;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error carregant indicadors de transparència");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
