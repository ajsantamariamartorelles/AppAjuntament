@page "/dades-municipals/fonts-naturals"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using AppAjuntament.Models.FontsNaturals
@using AppAjuntament.Services
@inject FontsNaturalsService FontsNaturalsService
@inject ILogger<FontsNaturals> Logger

<PageTitle>Qualitat de l'Aigua – Fonts Naturals</PageTitle>

<div class="container-fluid">
    <div class="screen-header">
        <h1 class="h3 mb-0">
            <i class="fas fa-tint me-2 text-primary"></i>
            Qualitat de l'Aigua – Fonts Naturals
        </h1>
        <button class="btn btn-outline-primary" @onclick="Carregar" disabled="@isLoading">
            @if (isLoading)
            {
                <i class="fas fa-spinner fa-spin me-2"></i>
            }
            else
            {
                <i class="fas fa-sync-alt me-2"></i>
            }
            Actualitzar
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3">Carregant dades de les fonts...</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            @errorMessage
        </div>
    }
    else if (fonts.Any())
    {
        <div class="row mb-3">
            <div class="col-12">
                <div class="d-flex gap-3 flex-wrap">
                    <span class="badge bg-success fs-6 px-3 py-2"><i class="fas fa-check-circle me-1"></i> Apta</span>
                    <span class="badge bg-warning text-dark fs-6 px-3 py-2"><i class="fas fa-exclamation-circle me-1"></i> Apta amb restriccions</span>
                    <span class="badge bg-danger fs-6 px-3 py-2"><i class="fas fa-times-circle me-1"></i> No apta</span>
                    <span class="badge bg-secondary fs-6 px-3 py-2"><i class="fas fa-question-circle me-1"></i> Sense dades</span>
                </div>
            </div>
        </div>

        <div class="row">
            @foreach (var font in fonts)
            {
                <div class="col-12 col-md-6 col-xl-4 mb-4">
                    <div class="card h-100 shadow-sm @GetCardBorderClass(font.CATEGORIA)">
                        @if (!string.IsNullOrEmpty(font.FDB_FOTO))
                        {
                            <img src="@font.FDB_FOTO" class="card-img-top" style="height:180px;object-fit:cover;" alt="@font.FDB_NOM_FONT" />
                        }
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <strong>@font.FDB_NOM_FONT</strong>
                            <span class="badge @GetBadgeClass(font.CATEGORIA)">@GetCategoriaText(font.CATEGORIA)</span>
                        </div>
                        <div class="card-body">
                            <div class="row g-2 text-center mb-3">
                                <div class="col-4">
                                    <div class="border rounded p-2">
                                        <div class="text-muted small">pH</div>
                                        <div class="fw-bold">@FormatValor(font.FDA_PH)</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="border rounded p-2">
                                        <div class="text-muted small">E. Coli</div>
                                        <div class="fw-bold @(font.FDA_E_COLI > 0 ? "text-danger" : "text-success")">
                                            @FormatValor(font.FDA_E_COLI)
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="border rounded p-2">
                                        <div class="text-muted small">Coliforms</div>
                                        <div class="fw-bold @(font.FDA_BACT_COLIFORMS > 0 ? "text-warning" : "text-success")">
                                            @FormatValor(font.FDA_BACT_COLIFORMS)
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="border rounded p-2">
                                        <div class="text-muted small">Temperatura</div>
                                        <div class="fw-bold">@(font.FDA_TEMPERATURA.HasValue ? $"{font.FDA_TEMPERATURA}°C" : "–")</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="border rounded p-2">
                                        <div class="text-muted small">Cabal</div>
                                        <div class="fw-bold">@(font.FDA_CABAL.HasValue ? $"{font.FDA_CABAL} L/m" : "–")</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="border rounded p-2">
                                        <div class="text-muted small">Altitud</div>
                                        <div class="fw-bold">@(font.FDB_ALTITUD.HasValue ? $"{font.FDB_ALTITUD} m" : "–")</div>
                                    </div>
                                </div>
                            </div>

                            @if (font.DataRecollida.HasValue)
                            {
                                <small class="text-muted">
                                    <i class="fas fa-calendar me-1"></i>
                                    Última anàlisi: @font.DataRecollida.Value.ToString("dd/MM/yyyy")
                                </small>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(font.INFORME))
                        {
                            <div class="card-footer bg-white">
                                <a href="@font.INFORME" target="_blank" class="btn btn-outline-primary btn-sm w-100">
                                    <i class="fas fa-file-pdf me-1"></i> Veure informe
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <small class="text-muted">
            <i class="fas fa-info-circle me-1"></i>
            Dades proporcionades per la Diputació de Barcelona – Oficina Tècnica d'Avaluació i Gestió Ambiental.
        </small>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="fas fa-tint fa-3x mb-3"></i>
            <h4>No hi ha fonts registrades per a aquest municipi.</h4>
        </div>
    }
</div>

@code {
    private List<FontNaturalAttributes> fonts = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await Carregar();

    private async Task Carregar()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();
            fonts = await FontsNaturalsService.GetFontsNaturalsAsync();
        }
        catch (TaskCanceledException)
        {
            errorMessage = "El servei DIBA no està disponible en aquest moment.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error carregant fonts naturals");
            errorMessage = "No s'han pogut carregar les dades de les fonts.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string GetCategoriaText(int? cat) => cat switch
    {
        1 => "Apta",
        2 => "Apta amb restriccions",
        3 => "No apta",
        _ => "Sense dades"
    };

    private string GetBadgeClass(int? cat) => cat switch
    {
        1 => "bg-success",
        2 => "bg-warning text-dark",
        3 => "bg-danger",
        _ => "bg-secondary"
    };

    private string GetCardBorderClass(int? cat) => cat switch
    {
        1 => "border-success",
        2 => "border-warning",
        3 => "border-danger",
        _ => ""
    };

    private string FormatValor(double? valor) => valor.HasValue ? valor.Value.ToString("G4") : "–";
}
