        "ENLLAC_PUBLICACIO"
    };

    private static bool IsHiddenField(string fieldId)
    {
        return HiddenFields.Contains(fieldId);
    }

    private static FormattedCellValue FormatCellValue(string fieldId, object? rawValue, int maxLength)
    {
        var text = GetValueAsString(rawValue);
        if (string.IsNullOrWhiteSpace(text))
        {
            return new FormattedCellValue();
        }

        text = text.Trim();
        if (TryBuildLink(fieldId, text, out var href))
        {
            return new FormattedCellValue
            {
                IsLink = true,
                LinkUrl = href,
                Text = TruncateText(text, maxLength)
            };
        }

        if (TryTranslateCodedValue(fieldId, text, out var translated))
        {
            return new FormattedCellValue { Text = translated };
        }

        if ((LooksLikeCurrencyField(fieldId) || text.Contains("€", StringComparison.Ordinal) || text.Contains("EUR", StringComparison.OrdinalIgnoreCase))
            && !LooksLikeYearField(fieldId)
            && TryParseAmount(text, out var amount)
            && !LooksLikeYear(amount))
        {
            return new FormattedCellValue { Text = amount.ToString("C2", CultureInfo.GetCultureInfo("ca-ES")) };
        }

        return new FormattedCellValue { Text = TruncateText(text, maxLength) };
    }

    private static string GetValueAsString(object? rawValue)
    {
        if (rawValue is null)
        {
            return string.Empty;
        }

        if (rawValue is JsonElement jsonElement)
        {
            return jsonElement.ValueKind switch
            {
                JsonValueKind.String => jsonElement.GetString() ?? string.Empty,
                JsonValueKind.Number => jsonElement.ToString(),
                JsonValueKind.True => bool.TrueString,
                JsonValueKind.False => bool.FalseString,
                _ => jsonElement.ToString()
            };
        }

        return rawValue.ToString() ?? string.Empty;
    }

    private static bool TryBuildLink(string fieldId, string text, out string? href)
    {
        href = null;
        if (!LooksLikeLinkField(fieldId) && !LooksLikeAbsoluteUrl(text))
        {
            return false;
        }

        var candidate = text;
        if (candidate.StartsWith("www.", StringComparison.OrdinalIgnoreCase))
        {
            candidate = $"https://{candidate}";
        }

        if (Uri.TryCreate(candidate, UriKind.Absolute, out var uri)
            && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps))
        {
            href = uri.ToString();
            return true;
        }

        return false;
    }

    private static bool LooksLikeAbsoluteUrl(string text)
    {
        return text.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || text.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            || text.StartsWith("www.", StringComparison.OrdinalIgnoreCase);
    }

    private static bool LooksLikeLinkField(string fieldId)
    {
        return LinkFieldHints.Any(hint => fieldId.Contains(hint, StringComparison.OrdinalIgnoreCase));
    }

    private static bool LooksLikeCurrencyField(string fieldId)
    {
        return CurrencyFieldHints.Any(hint => fieldId.Contains(hint, StringComparison.OrdinalIgnoreCase));
    }

    private static readonly string[] YearFieldHints = { "ANY", "YEAR", "ANYO" };

    private static bool LooksLikeYearField(string fieldId)
    {
        return YearFieldHints.Any(hint => fieldId.Contains(hint, StringComparison.OrdinalIgnoreCase));
    }

    private static bool LooksLikeYear(decimal value)
    {
        return value == Math.Floor(value) && value >= 1800 && value <= 2100;
    }

    private static bool TryTranslateCodedValue(string fieldId, string text, out string translated)
    {
        translated = string.Empty;

        var normalized = text.Trim();
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return false;
        }

        if (TryTranslateBudgetCode(fieldId, normalized, out translated))
        {
            return true;
        }

        if (!IsStatusLikeField(fieldId))
        {
            return false;
        }

        if (normalized == "1")
        {
            translated = "Actiu";
            return true;
        }

        if (normalized == "0")
        {
            translated = "Inactiu";
            return true;
        }

        if (normalized.Equals("S", StringComparison.OrdinalIgnoreCase)
            || normalized.Equals("SI", StringComparison.OrdinalIgnoreCase)
            || normalized.Equals("Y", StringComparison.OrdinalIgnoreCase)
            || normalized.Equals("YES", StringComparison.OrdinalIgnoreCase)
            || normalized.Equals("TRUE", StringComparison.OrdinalIgnoreCase))
        {
            translated = "Actiu";
            return true;
        }

        if (normalized.Equals("N", StringComparison.OrdinalIgnoreCase)
            || normalized.Equals("NO", StringComparison.OrdinalIgnoreCase)
            || normalized.Equals("FALSE", StringComparison.OrdinalIgnoreCase))
        {
            translated = "Inactiu";
            return true;
        }

        return false;
    }

    private static bool TryTranslateBudgetCode(string fieldId, string value, out string translated)
    {
        translated = string.Empty;
        var key = NormalizeFieldKey(fieldId);

        if (key == "TIPUSPARTIDA")
        {
            if (value.Equals("I", StringComparison.OrdinalIgnoreCase))
            {
                translated = "Ingressos";
                return true;
            }

            if (value.Equals("D", StringComparison.OrdinalIgnoreCase))
            {
                translated = "Despeses";
                return true;
            }
        }

        if (key == "TIPUSCLASSIF")
        {
            if (value.Equals("E", StringComparison.OrdinalIgnoreCase))
            {
                translated = "Economica";
                return true;
            }

            if (value.Equals("P", StringComparison.OrdinalIgnoreCase))
            {
                translated = "Per programes";
                return true;
            }
        }

        if (key == "CODIPANTALLA")
        {
            if (value == "1")
            {
                translated = "Ingressos";
                return true;
            }

            if (value == "2")
            {
                translated = "Despeses";
                return true;
            }
        }

        if (key == "NIVELL" && int.TryParse(value, out var level))
        {
            translated = level switch
            {
                1 => "Capítol",
                2 => "Article",
                3 => "Concepte",
                4 => "Subconcepte",
                5 => "Partida",
                _ => $"Nivell {level}"
            };
            return true;
        }

        if (key == "CODITIPUSRELACIO" || key == "TIPUSRELACIO" || key == "NOMTIPUSRELACIO")
        {
            translated = value.ToUpperInvariant() switch
            {
                "M"  => "Membre",
                "F"  => "Fundador",
                "P"  => "Participant",
                "C"  => "Consorci",
                "A"  => "Adscrit",
                "V"  => "Vinculat",
                "D"  => "Dependent",
                "E"  => "Entitat vinculada",
                "1"  => "Membre fundador",
                "2"  => "Membre",
                "3"  => "Participant",
                "4"  => "Adscrit",
                "5"  => "Vinculat",
                "MF" => "Membre fundador",
                "ME" => "Membre",
                "PA" => "Participant",
                _    => value
            };
            return translated != value;
        }

        return false;
    }

    private static string NormalizeFieldKey(string fieldId)
    {
        return new string(fieldId.Where(char.IsLetterOrDigit).ToArray()).ToUpperInvariant();
    }

    private static bool IsStatusLikeField(string fieldId)
    {
        var statusFieldHints = new[]
        {
            "ACTIU", "ACTIVA", "ACTIVO", "ACTIVA", "ESTAT", "STATUS", "VIGENT", "VALID",
            "ENABLED", "HABILITAT", "PUBLICAT", "VISIBLE", "FLAG", "IS_", "_IS"
        };

        return statusFieldHints.Any(hint => fieldId.Contains(hint, StringComparison.OrdinalIgnoreCase));
    }

    private static bool TryParseAmount(string text, out decimal amount)
    {
        amount = 0;

        var normalized = text.Replace("€", string.Empty, StringComparison.Ordinal)
            .Replace("EUR", string.Empty, StringComparison.OrdinalIgnoreCase)
            .Trim();

        // L'API retorna números en format invariant (punt decimal). Cal provar-ho primer.
        if (decimal.TryParse(normalized, NumberStyles.Number, CultureInfo.InvariantCulture, out amount))
        {
            return true;
        }

        if (decimal.TryParse(normalized, NumberStyles.Number, CultureInfo.GetCultureInfo("ca-ES"), out amount))
        {
            return true;
        }

        return false;
    }

    private static string TruncateText(string text, int maxLength)
    {
        return text.Length > maxLength ? text[..maxLength] + "..." : text;
    }

    // Columnes prioritàries per categoria d'API. Si la categoria no té llista, es mostren les 7 primeres.
