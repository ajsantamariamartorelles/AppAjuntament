    private static List<CkanField> GetPriorityFields(SeuApiRecord api, List<CkanField> allVisible)
    {
        if (PriorityFieldsByCategory.TryGetValue(api.Categoria, out var priorityNames))
        {
            // Mantenim l'ordre de priorityNames, incloem els que existeixin
            var prioritySet = priorityNames
                .Select(name => allVisible.FirstOrDefault(f =>
                    f.Id.Equals(name, StringComparison.OrdinalIgnoreCase) ||
                    f.Id.Contains(name, StringComparison.OrdinalIgnoreCase)))
                .Where(f => f != null)
                .Select(f => f!)
                .Distinct()
                .ToList();

            // Si no hem trobat prou columnes prioritàries, complementem amb les primeres visibles
            if (prioritySet.Count < 3)
                return allVisible.Take(7).ToList();

            return prioritySet;
        }

        // Sense categoria específica: les primeres 7
        return allVisible.Take(7).ToList();
    }
