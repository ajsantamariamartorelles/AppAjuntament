    {
        // Identificadors de l'ens (ja sabem a quin municipi som)
        "CODI_ENS",
        "CODI_ENS_ACTIVITAT",
        "CODI_ENS_PARE",
        "NOM_ENS",
        "NOM_ENS_PARE",
        "NOM_COMPLET",
        "NOM_COMPLET_ENS",
        "NOM_MUNICIPI",
        "MUNICIPI",
        "NOM_ENS_LOCAL",
        "ID_ORGANISME_CONTRACTANT",
        "CODIINE",
        "CODI_INE10",
        "CODI_INE",
        "_id",
        // Tipus impositius: camps tècnics interns sense valor per a l'usuari
        "CODI_DOCUMENT",
        "CODI_ESTRUCTURA",
        // Contractació: no útils per a l'usuari final
        "URL_JSON_FUTURA",
        "URL_JSON_CPM",
        "URL_JSON_PREVI",
        // Codis tècnics interns de contractació
        "CODI_AMBIT",
