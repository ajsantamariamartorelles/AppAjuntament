            "CODI_PARTIDA", "DESCRIPCIO_PARTIDA", "DESCRIPCIO",
            "IMPORT_PRESSUPOST", "IMPORT_INICIAL", "IMPORT_DEFINITIU"
        },
        ["Govern"] = new[]
