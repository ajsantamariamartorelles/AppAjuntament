@page "/estadistiques-municipi"
@using AppAjuntament.Models.Idescat
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using AppAjuntament.Services
@using System.Globalization
@using System.Text
@using ClosedXML.Excel
@inject IIdescatEmexService IdescatService
@inject ILogger<EstadistiquesMunicipi> Logger
@inject IJSRuntime JS

<PageTitle>Estadistiques del municipi</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="screen-header">
                <h1 class="h3 mb-0 screen-title">
                    <i class="fas fa-chart-line me-2 text-primary"></i>
                    Estadistiques del municipi
                </h1>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-success" @onclick="ExportarCsv" disabled="@(isLoading || activeTab != "detall" || !filteredIndicadors.Any())">
                        <i class="fas fa-file-csv me-2"></i>
                        CSV
                    </button>
                    <button class="btn btn-outline-success" @onclick="ExportarExcel" disabled="@(isLoading || activeTab != "detall" || !filteredIndicadors.Any())">
                        <i class="fas fa-file-excel me-2"></i>
                        Excel
                    </button>
                    <button class="btn btn-outline-primary" @onclick="RecarregarDades" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <i class="fas fa-spinner fa-spin me-2"></i>
                        }
                        else
                        {
                            <i class="fas fa-sync-alt me-2"></i>
                        }
                        Actualitzar
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(dades?.NomMunicipi))
            {
                <div class="mb-3">
                    <span class="badge bg-primary me-2">@dades.NomMunicipi</span>
                    @if (!string.IsNullOrWhiteSpace(dades.NomComarca))
                    {
                        <span class="badge bg-secondary me-2">@dades.NomComarca</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(dades.NomCatalunya))
                    {
                        <span class="badge bg-light text-dark border">@dades.NomCatalunya</span>
                    }
                </div>
            }

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Carregant...</span>
                    </div>
                    <p class="mt-3">Carregant estadistiques d'IDESCAT...</p>
                </div>
            }
            else if (hasError)
            {
                <div class="alert alert-danger" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Error en carregar les dades estadistiques d'IDESCAT.
                </div>
            }
            else if (dades?.Indicadors?.Any() == true)
            {
                <ul class="nav nav-pills mb-3 gap-2">
                    <li class="nav-item">
                        <button class="nav-link @(IsActiveTab("poblacio") ? "active" : string.Empty)" @onclick='() => SelectTab("poblacio")'>
                            <i class="fas fa-users me-1"></i>Poblacio
                        </button>
                    </li>
                    @foreach (var ambit in altresAmbits)
                    {
                        <li class="nav-item">
                            <button class="nav-link @(IsActiveTab(ambit.Key) ? "active" : string.Empty)" @onclick="() => SelectTab(ambit.Key)">
                                <i class="@GetTabIconClass(ambit.Key) me-1"></i>@ambit.Titol
                            </button>
                        </li>
                    }
                    <li class="nav-item">
                        <button class="nav-link @(IsActiveTab("tots") ? "active" : string.Empty)" @onclick='() => SelectTab("tots")'>
                            <i class="fas fa-layer-group me-1"></i>Tots
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(IsActiveTab("detall") ? "active" : string.Empty)" @onclick='() => SelectTab("detall")'>
                            <i class="fas fa-table me-1"></i>Detall tecnic
                        </button>
                    </li>
                </ul>

                @if (activeTab == "poblacio" && populationDashboard != null)
                {
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body">
                                    <div class="text-muted small">Poblacio total</div>
                                    <div class="h2 mb-1">@FormatNumber(populationDashboard.Municipi.Total)</div>
                                    <div class="small text-secondary">@dades?.NomMunicipi (@populationDashboard.Municipi.Periode)</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body">
                                    <div class="text-muted small">Homes</div>
                                    <div class="h2 mb-1">@FormatNumber(populationDashboard.Municipi.Homes)</div>
                                    <div class="small text-secondary">@Percentatge(populationDashboard.Municipi.Homes, populationDashboard.Municipi.Total) del total</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body">
                                    <div class="text-muted small">Dones</div>
                                    <div class="h2 mb-1">@FormatNumber(populationDashboard.Municipi.Dones)</div>
                                    <div class="small text-secondary">@Percentatge(populationDashboard.Municipi.Dones, populationDashboard.Municipi.Total) del total</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-lg-4">
                            <div class="card shadow-sm h-100">
                                <div class="card-header bg-white">
                                    <strong>Distribucio per sexe</strong>
                                </div>
                                <div class="card-body" style="height:320px;">
                                    <canvas id="populationSexChart"></canvas>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-8">
                            <div class="card shadow-sm h-100">
                                <div class="card-header bg-white">
                                    <strong>Comparativa de poblacio total (escala log)</strong>
                                </div>
                                <div class="card-body" style="height:320px;">
                                    <canvas id="populationComparativeChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm mb-3">
                        <div class="card-header bg-white">
                            <strong>Piramide d'edat</strong>
                        </div>
                        <div class="card-body" style="height:420px;">
                            <canvas id="populationPyramidChart"></canvas>
                        </div>
                    </div>

                }
                else if (activeTab == "tots")
                {
                    <div class="card shadow-sm screen-filters-card mb-3">
                        <div class="card-body">
                            <div class="row g-2 align-items-end">
                                <div class="col-12 col-md-5 col-lg-4">
                                    <label for="thematicSearchAll" class="form-label">Cerca a totes les pestanyes</label>
                                    <input id="thematicSearchAll"
                                           type="text"
                                           class="form-control"
                                           placeholder="Nom o codi indicador"
                                           @bind="thematicSearchTerm"
                                           @bind:event="oninput" />
                                </div>
                                <div class="col-12 col-md-4 col-lg-3">
                                    <label for="rowsPerTableAll" class="form-label">Files per taula</label>
                                    <select id="rowsPerTableAll" class="form-select" @bind="rowsPerTable" @bind:after="OnRowsPerTableChangedAsync">
                                        <option value="10">10</option>
                                        <option value="25">25</option>
                                        <option value="0">Totes</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    @foreach (var ambit in altresAmbits)
                    {
                        var ambitTables = BuildActiveTabTables(ambit.Key);

                        <div class="card shadow-sm mb-3">
                            <div class="card-header bg-white">
                                <strong>@ambit.Titol</strong>
                            </div>
                            <div class="card-body">
                                <div class="small text-muted mb-3">@ambitTables.Sum(t => t.Rows.Count) indicadors disponibles</div>

                                @if (ambit.Kpis.Any())
                                {
                                    <div class="row g-2 mb-4">
                                        @foreach (var kpi in ambit.Kpis)
                                        {
                                            <div class="col-12 col-lg-6">
                                                <div class="border rounded p-2 h-100 bg-light">
                                                    <div class="fw-semibold">@kpi.Nom</div>
                                                    <div class="small text-muted">@kpi.Periode @(string.IsNullOrWhiteSpace(kpi.Unitat) ? string.Empty : "- " + kpi.Unitat)</div>
                                                    <div class="small mt-1">M: <strong>@kpi.MunicipiText</strong> | C: @kpi.ComarcaText | CAT: @kpi.CatalunyaText</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                @foreach (var taula in ambitTables)
                                {
                                    <div class="card mb-3 border">
                                        <div class="card-header bg-light">
                                            <strong>@taula.TableName</strong>
                                        </div>
                                        <div class="table-responsive">
                                            <table class="table table-sm table-striped mb-0 align-middle">
                                                <thead>
                                                    <tr>
                                                        <th>Indicador</th>
                                                        <th class="text-end">Municipi</th>
                                                        <th class="text-end d-none d-md-table-cell">Comarca</th>
                                                        <th class="text-end d-none d-lg-table-cell">Catalunya</th>
                                                        <th class="d-none d-md-table-cell">Periode</th>
                                                        <th class="d-none d-lg-table-cell">Unitat</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var row in LimitRows(taula.Rows))
                                                    {
                                                        <tr>
                                                            <td>
                                                                <div class="fw-semibold">@row.IndicadorNom</div>
                                                                <small class="text-muted">@row.IndicadorId</small>
                                                            </td>
                                                            <td class="text-end fw-semibold">@FormatValor(row.ValorMunicipiText)</td>
                                                            <td class="text-end d-none d-md-table-cell">@FormatValor(row.ValorComarcaText)</td>
                                                            <td class="text-end d-none d-lg-table-cell">@FormatValor(row.ValorCatalunyaText)</td>
                                                            <td class="d-none d-md-table-cell">@(row.ReferenciaTemporal ?? "-")</td>
                                                            <td class="d-none d-lg-table-cell">@(row.Unitat ?? "-")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else if (activeTab != "detall")
                {
                    @if (selectedAmbit != null)
                    {
                        <div class="card shadow-sm mb-3">
                            <div class="card-header bg-white">
                                <strong>@selectedAmbit.Titol</strong>
                            </div>
                            <div class="card-body">
                                <h6 class="mb-2">Resum</h6>
                                <div class="small text-muted mb-3">
                                    @activeTabTables.Sum(t => t.Rows.Count) indicadors disponibles organitzats per taula, en format comparatiu municipi/comarca/Catalunya.
                                </div>

                                @if (selectedAmbit.Kpis.Any())
                                {
                                    <h6 class="mb-3">Indicadors destacats</h6>

                                    <div class="row g-2 mb-4">
                                        @foreach (var kpi in selectedAmbit.Kpis)
                                        {
                                            <div class="col-12 col-lg-6">
                                                <div class="border rounded p-2 h-100 bg-light">
                                                    <div class="fw-semibold">@kpi.Nom</div>
                                                    <div class="small text-muted">@kpi.Periode @(string.IsNullOrWhiteSpace(kpi.Unitat) ? string.Empty : "- " + kpi.Unitat)</div>
                                                    <div class="small mt-1">M: <strong>@kpi.MunicipiText</strong> | C: @kpi.ComarcaText | CAT: @kpi.CatalunyaText</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                @if (selectedAmbit.EnableChart && thematicChartData.Any())
                                {
                                    <div class="card border mb-4">
                                        <div class="card-header bg-white">
                                            <strong>Comparativa rapida d'indicadors (municipi)</strong>
                                        </div>
                                        <div class="card-body" style="height:320px;">
                                            <canvas id="thematicChart"></canvas>
                                        </div>
                                    </div>
                                }

                                <h6 class="mb-3">Indicadors per taules</h6>

                                <div class="row g-2 mb-3 align-items-end">
                                    <div class="col-12 col-md-5 col-lg-4">
                                        <label for="thematicSearch" class="form-label">Cerca dins la pestanya</label>
                                        <input id="thematicSearch"
                                               type="text"
                                               class="form-control"
                                               placeholder="Nom o codi indicador"
                                               @bind="thematicSearchTerm"
                                               @bind:event="oninput" />
                                    </div>
                                    <div class="col-12 col-md-4 col-lg-3">
                                        <label for="rowsPerTable" class="form-label">Files per taula</label>
                                        <select id="rowsPerTable" class="form-select" @bind="rowsPerTable" @bind:after="OnRowsPerTableChangedAsync">
                                            <option value="10">10</option>
                                            <option value="25">25</option>
                                            <option value="0">Totes</option>
                                        </select>
                                    </div>
                                </div>

                                @foreach (var taula in activeTabTables)
                                {
                                    <div class="card mb-3 border">
                                        <div class="card-header bg-light">
                                            <strong>@taula.TableName</strong>
                                        </div>
                                        <div class="table-responsive">
                                            <table class="table table-sm table-striped mb-0 align-middle">
                                                <thead>
                                                    <tr>
                                                        <th>Indicador</th>
                                                        <th class="text-end">Municipi</th>
                                                        <th class="text-end d-none d-md-table-cell">Comarca</th>
                                                        <th class="text-end d-none d-lg-table-cell">Catalunya</th>
                                                        <th class="d-none d-md-table-cell">Periode</th>
                                                        <th class="d-none d-lg-table-cell">Unitat</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var row in LimitRows(taula.Rows))
                                                    {
                                                        <tr>
                                                            <td>
                                                                <div class="fw-semibold">@row.IndicadorNom</div>
                                                                <small class="text-muted">@row.IndicadorId</small>
                                                            </td>
                                                            <td class="text-end fw-semibold">@FormatValor(row.ValorMunicipiText)</td>
                                                            <td class="text-end d-none d-md-table-cell">@FormatValor(row.ValorComarcaText)</td>
                                                            <td class="text-end d-none d-lg-table-cell">@FormatValor(row.ValorCatalunyaText)</td>
                                                            <td class="d-none d-md-table-cell">@(row.ReferenciaTemporal ?? "-")</td>
                                                            <td class="d-none d-lg-table-cell">@(row.Unitat ?? "-")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info" role="alert">
                            No hi ha dades disponibles per aquest ambit.
                        </div>
                    }
                }

                @if (activeTab == "detall")
                {
                    <div class="card shadow-sm screen-filters-card mb-3">
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-12 col-lg-5">
                                    <label for="searchInput" class="form-label">Cercar indicador</label>
                                    <div class="input-group">
                                        <span class="input-group-text">
                                            <i class="fas fa-search"></i>
                                        </span>
                                        <input id="searchInput" type="text" class="form-control" placeholder="Nom d'indicador o taula..."
                                               @bind="searchTerm" @bind:event="oninput" />
                                    </div>
                                </div>
                                <div class="col-12 col-lg-4">
                                    <label for="grupSelect" class="form-label">Grup</label>
                                    <select id="grupSelect" class="form-select" @bind="selectedGrup" @bind:after="OnGroupChanged">
                                        <option value="">Tots els grups</option>
                                        @foreach (var grup in grupsDisponibles)
                                        {
                                            <option value="@grup">@grup</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-lg-3">
                                    <label for="periodeSelect" class="form-label">Periode</label>
                                    <select id="periodeSelect" class="form-select" @bind="selectedPeriode">
                                        <option value="">Tots els periodes</option>
                                        @foreach (var periode in periodesDisponibles)
                                        {
                                            <option value="@periode">@periode</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-lg-12 d-flex align-items-end">
                                    <span class="badge bg-info">
                                        @filteredIndicadors.Count() indicadors
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>Grup</th>
                                    <th>Taula</th>
                                    <th>Indicador</th>
                                    <th class="text-end">Municipi</th>
                                    <th class="text-end">Comarca</th>
                                    <th class="text-end">Catalunya</th>
                                    <th>Periode</th>
                                    <th>Unitat</th>
                                    <th>Actualitzat</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in filteredIndicadors)
                                {
                                    <tr>
                                        <td>@item.GrupNom</td>
                                        <td>@item.TaulaNom</td>
                                        <td>
                                            <div class="fw-semibold">@item.IndicadorNom</div>
                                            <small class="text-muted">@item.IndicadorId</small>
                                        </td>
                                        <td class="text-end fw-semibold">@FormatValor(item.ValorMunicipiText)</td>
                                        <td class="text-end">@FormatValor(item.ValorComarcaText)</td>
                                        <td class="text-end">@FormatValor(item.ValorCatalunyaText)</td>
                                        <td>@(item.ReferenciaTemporal ?? "-")</td>
                                        <td>@(item.Unitat ?? "-")</td>
                                        <td>@FormatData(item.DataActualitzacio)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    <i class="fas fa-info-circle me-2"></i>
                    No hi ha indicadors disponibles per aquest municipi.
                </div>
            }
        </div>
    </div>
</div>

@code {
    private IdescatEmexData? dades;
    private bool isLoading = true;
    private bool hasError;
    private bool chartsNeedRefresh;
    private bool thematicChartNeedsRefresh;
    private string activeTab = "poblacio";
    private int rowsPerTable = 10;
    private string thematicSearchTerm = string.Empty;
    private string searchTerm = string.Empty;
    private string selectedGrup = string.Empty;
    private string selectedPeriode = string.Empty;
    private PopulationDashboard? populationDashboard;

    private ThematicDashboard? selectedAmbit =>
        altresAmbits.FirstOrDefault(a => string.Equals(a.Key, activeTab, StringComparison.OrdinalIgnoreCase));

    private List<TabIndicatorsTable> activeTabTables => BuildActiveTabTables(activeTab);

    private List<ThematicChartPoint> thematicChartData => BuildThematicChartData();

    private List<ThematicDashboard> altresAmbits => new List<ThematicDashboard>
    {
        BuildThematicDashboard("cultura-llengua", "Cultura · Llengua", new[] { "Cultura i llengua" }, new[]
        {
            (new[] { "f91" }, "Enten el catala"),
            (new[] { "f94" }, "Sap escriure catala"),
            (new[] { "f300" }, "Total espais esportius")
        }, true),
        BuildThematicDashboard("educacio", "Educacio", new[] { "Educacio" }, new[]
        {
            (new[] { "f389" }, "Educacio superior (%)"),
            (new[] { "f380" }, "Alumnes residents"),
            (new[] { "f381" }, "Estudien al mateix municipi (%)")
        }, true),
        BuildThematicDashboard("eleccions", "Eleccions", new[] { "Eleccions" }, new[]
        {
            (new[] { "f149" }, "Participacio eleccions municipals"),
            (new[] { "f254" }, "Participacio Parlament Catalunya"),
            (new[] { "f256" }, "Participacio Parlament Europeu")
        }, true),
        BuildEconomiaDashboard(),
        BuildThematicDashboard("qualitat-vida", "Qualitat de vida", new[] { "Qualitat de vida" }, new[]
        {
            (new[] { "f122" }, "Habitatges familiars"),
            (new[] { "f401" }, "Habitatges de lloguer (%)"),
            (new[] { "f385" }, "Index socioeconomic territorial")
        }, true),
        BuildThematicDashboard("macromagnituds-finances", "Macromagnituds · Finances publiques", new[] { "Macromagnituds i finances publiques" }, new[]
        {
            (new[] { "f198" }, "IBI - nombre de rebuts"),
            (new[] { "f200" }, "IBI - quota integra"),
            (new[] { "f10" }, "IRPF base imposable")
        }, true),
        BuildThematicDashboard("sectors-economics", "Sectors economics", new[] { "Sectors economics" }, new[]
        {
            (new[] { "f349" }, "Vinya (hectarees)"),
            (new[] { "f163" }, "Parc total de vehicles"),
            (new[] { "f216" }, "Places d'hotels")
        }, true),
        BuildThematicDashboard("medi-ambient", "Medi ambient", new[] { "Medi ambient" }, new[]
        {
            (new[] { "f366" }, "Residus municipals per capita"),
            (new[] { "f368" }, "Recollida selectiva"),
            (new[] { "f369" }, "Generacio de residus industrials")
        }, true)
    }.Where(d => d.Kpis.Any()).ToList();

    private List<string> grupsDisponibles => dades?.Indicadors
        .Select(i => i.GrupNom)
        .Where(g => !string.IsNullOrWhiteSpace(g))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(g => g)
        .ToList() ?? new List<string>();

    private List<string> periodesDisponibles => (dades?.Indicadors ?? Enumerable.Empty<IdescatEmexIndicatorRow>())
        .Where(i =>
            string.IsNullOrWhiteSpace(selectedGrup) ||
            string.Equals(i.GrupNom, selectedGrup, StringComparison.OrdinalIgnoreCase))
        .Select(i => i.ReferenciaTemporal)
        .Where(p => !string.IsNullOrWhiteSpace(p))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderByDescending(p => p)
        .Cast<string>()
        .ToList();

    private IEnumerable<IdescatEmexIndicatorRow> filteredIndicadors =>
        (dades?.Indicadors ?? Enumerable.Empty<IdescatEmexIndicatorRow>())
            .Where(i =>
                string.IsNullOrWhiteSpace(searchTerm) ||
                i.IndicadorNom.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                i.TaulaNom.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                i.GrupNom.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            .Where(i =>
                string.IsNullOrWhiteSpace(selectedGrup) ||
                string.Equals(i.GrupNom, selectedGrup, StringComparison.OrdinalIgnoreCase))
            .Where(i =>
                string.IsNullOrWhiteSpace(selectedPeriode) ||
                string.Equals(i.ReferenciaTemporal, selectedPeriode, StringComparison.OrdinalIgnoreCase))
            .OrderBy(i => i.GrupNom)
            .ThenBy(i => i.TaulaNom)
            .ThenBy(i => i.IndicadorNom);

    protected override async Task OnInitializedAsync()
    {
        await CarregarDades();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var savedRows = await JS.InvokeAsync<int?>("estadistiquesPreferences.getRowsPerTable");
                if (savedRows == 0 || savedRows == 10 || savedRows == 25)
                {
                    rowsPerTable = savedRows.Value;
                    StateHasChanged();
                }
            }
            catch
            {
                // Ignore client preference loading failures and keep default value.
            }
        }

        if (chartsNeedRefresh && populationDashboard != null)
        {
            chartsNeedRefresh = false;

            await JS.InvokeVoidAsync("renderPopulationDashboard", new
            {
                nomMunicipi = dades?.NomMunicipi,
                nomComarca = dades?.NomComarca,
                nomCatalunya = dades?.NomCatalunya,
                municipi = new
                {
                    total = populationDashboard.Municipi.Total,
                    homes = populationDashboard.Municipi.Homes,
                    dones = populationDashboard.Municipi.Dones
                },
                comarca = new
                {
                    total = populationDashboard.Comarca.Total,
                    homes = populationDashboard.Comarca.Homes,
                    dones = populationDashboard.Comarca.Dones
                },
                catalunya = new
                {
                    total = populationDashboard.Catalunya.Total,
                    homes = populationDashboard.Catalunya.Homes,
                    dones = populationDashboard.Catalunya.Dones
                },
                piramide = new
                {
                    labels = new[] { "0-14", "15-64", "65-84", "85+" },
                    homes = new[]
                    {
                        populationDashboard.Municipi.Homes0a14,
                        populationDashboard.Municipi.Homes15a64,
                        populationDashboard.Municipi.Homes65a84,
                        populationDashboard.Municipi.Homes85Mes
                    },
                    dones = new[]
                    {
                        populationDashboard.Municipi.Dones0a14,
                        populationDashboard.Municipi.Dones15a64,
                        populationDashboard.Municipi.Dones65a84,
                        populationDashboard.Municipi.Dones85Mes
                    }
                }
            });
        }

        if (thematicChartNeedsRefresh && selectedAmbit != null && selectedAmbit.EnableChart)
        {
            thematicChartNeedsRefresh = false;
            await JS.InvokeVoidAsync("renderThematicChart", new
            {
                title = selectedAmbit.Titol,
                labels = thematicChartData.Select(x => x.Label).ToArray(),
                values = thematicChartData.Select(x => x.Value).ToArray()
            });
        }
    }

    private async Task RecarregarDades()
    {
        await CarregarDades();
    }

    private async Task CarregarDades()
    {
        try
        {
            isLoading = true;
            hasError = false;
            StateHasChanged();

            dades = await IdescatService.ObtenirDadesMunicipiAsync();
            populationDashboard = ConstruirPopulationDashboard();
            chartsNeedRefresh = populationDashboard != null;

            if (dades == null)
            {
                hasError = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error carregant estadistiques del municipi");
            hasError = true;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

