    private void SelectTab(string tab)
    {
        activeTab = tab;
        thematicSearchTerm = string.Empty;
        thematicChartNeedsRefresh = activeTab != "poblacio" && activeTab != "detall" && activeTab != "tots";

        if (activeTab == "poblacio" && populationDashboard != null)
        {
            chartsNeedRefresh = true;
        }
    }

