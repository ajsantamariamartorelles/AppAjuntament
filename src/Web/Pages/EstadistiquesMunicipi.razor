    private IEnumerable<IdescatEmexIndicatorRow> LimitRows(List<IdescatEmexIndicatorRow> rows)
    {
        var filteredRows = FilterThematicRows(rows);

        if (rowsPerTable <= 0)
        {
            return filteredRows;
        }

        return filteredRows.Take(rowsPerTable);
    }

    private IEnumerable<IdescatEmexIndicatorRow> FilterThematicRows(IEnumerable<IdescatEmexIndicatorRow> rows)
    {
        if (string.IsNullOrWhiteSpace(thematicSearchTerm))
        {
            return rows;
        }

        return rows.Where(r =>
            (!string.IsNullOrWhiteSpace(r.IndicadorNom) &&
             r.IndicadorNom.Contains(thematicSearchTerm, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(r.IndicadorId) &&
             r.IndicadorId.Contains(thematicSearchTerm, StringComparison.OrdinalIgnoreCase)));
    }

    private async Task OnRowsPerTableChangedAsync()
    {
        await JS.InvokeVoidAsync("estadistiquesPreferences.setRowsPerTable", rowsPerTable);
    }

    private List<TabIndicatorsTable> BuildActiveTabTables(string tab)
    {
        if (dades?.Indicadors == null || string.IsNullOrWhiteSpace(tab) || tab == "poblacio" || tab == "detall" || tab == "tots")
        {
            return new List<TabIndicatorsTable>();
        }

        var groups = GetGroupsForTab(tab);
        var fallbackIndicatorIds = GetIndicatorIdsForTab(tab);

        return dades.Indicadors
            .Where(i =>
                groups.Contains(i.GrupNom, StringComparer.OrdinalIgnoreCase) ||
                fallbackIndicatorIds.Contains(i.IndicadorId, StringComparer.OrdinalIgnoreCase))
            .GroupBy(i => new { i.TaulaId, i.TaulaNom })
            .OrderBy(g => g.Key.TaulaNom)
            .Select(g => new TabIndicatorsTable(
                g.Key.TaulaNom,
                g.OrderBy(i => i.IndicadorNom).ToList()))
            .ToList();
    }

    private static string[] GetIndicatorIdsForTab(string tab)
    {
        return tab switch
        {
            "cultura-llengua" => new[] { "f91", "f94", "f300" },
            "educacio" => new[] { "f389", "f380", "f381" },
            "eleccions" => new[] { "f149", "f254", "f256" },
            "economia" => new[] { "f223", "f308", "f377", "f363" },
            "qualitat-vida" => new[] { "f122", "f401", "f385" },
            "macromagnituds-finances" => new[] { "f198", "f200", "f10" },
            "sectors-economics" => new[] { "f349", "f163", "f216" },
            "medi-ambient" => new[] { "f366", "f368", "f369" },
            _ => Array.Empty<string>()
        };
    }

    private static string[] GetGroupsForTab(string tab)
    {
        var configuredGroups = new Dictionary<string, string[]>(StringComparer.OrdinalIgnoreCase)
        {
            ["cultura-llengua"] = new[] { "Cultura i llengua" },
            ["educacio"] = new[] { "Educacio" },
            ["eleccions"] = new[] { "Eleccions" },
            ["economia"] = new[] { "Treball" },
            ["qualitat-vida"] = new[] { "Qualitat de vida" },
            ["macromagnituds-finances"] = new[] { "Macromagnituds i finances publiques" },
            ["sectors-economics"] = new[] { "Sectors economics" },
            ["medi-ambient"] = new[] { "Medi ambient" }
        };

        if (configuredGroups.TryGetValue(tab, out var groups))
        {
            return groups;
        }

        return tab switch
        {
            _ => Array.Empty<string>()
        };
    }

    private async Task ExportarCsv()
    {
        var rows = filteredIndicadors.ToList();
        if (!rows.Any())
        {
            return;
        }

        var csv = new StringBuilder();
        csv.AppendLine("Grup;Taula;IndicadorId;Indicador;Municipi;Comarca;Catalunya;Periode;Unitat;Actualitzat");

        foreach (var item in rows)
        {
            csv.AppendLine(string.Join(';',
                EscapeCsv(item.GrupNom),
                EscapeCsv(item.TaulaNom),
                EscapeCsv(item.IndicadorId),
                EscapeCsv(item.IndicadorNom),
                EscapeCsv(item.ValorMunicipiText),
                EscapeCsv(item.ValorComarcaText),
                EscapeCsv(item.ValorCatalunyaText),
                EscapeCsv(item.ReferenciaTemporal ?? string.Empty),
                EscapeCsv(item.Unitat ?? string.Empty),
                EscapeCsv(FormatData(item.DataActualitzacio))));
        }

        var bytes = Encoding.UTF8.GetBytes(csv.ToString());
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"estadistiques-{DateTime.Now:yyyyMMdd-HHmm}.csv";

        await JS.InvokeVoidAsync("downloadBase64File", base64, fileName, "text/csv;charset=utf-8");
    }

    private async Task ExportarExcel()
    {
        var rows = filteredIndicadors.ToList();
        if (!rows.Any())
        {
            return;
        }

        using var workbook = new XLWorkbook();
        var ws = workbook.Worksheets.Add("Estadistiques");

        ws.Cell(1, 1).Value = "Grup";
        ws.Cell(1, 2).Value = "Taula";
        ws.Cell(1, 3).Value = "IndicadorId";
        ws.Cell(1, 4).Value = "Indicador";
        ws.Cell(1, 5).Value = "Municipi";
        ws.Cell(1, 6).Value = "Comarca";
        ws.Cell(1, 7).Value = "Catalunya";
        ws.Cell(1, 8).Value = "Periode";
        ws.Cell(1, 9).Value = "Unitat";
        ws.Cell(1, 10).Value = "Actualitzat";

        var rowIndex = 2;
        foreach (var item in rows)
        {
            ws.Cell(rowIndex, 1).Value = item.GrupNom;
            ws.Cell(rowIndex, 2).Value = item.TaulaNom;
            ws.Cell(rowIndex, 3).Value = item.IndicadorId;
            ws.Cell(rowIndex, 4).Value = item.IndicadorNom;
            ws.Cell(rowIndex, 5).Value = item.ValorMunicipiText;
            ws.Cell(rowIndex, 6).Value = item.ValorComarcaText;
            ws.Cell(rowIndex, 7).Value = item.ValorCatalunyaText;
            ws.Cell(rowIndex, 8).Value = item.ReferenciaTemporal ?? string.Empty;
            ws.Cell(rowIndex, 9).Value = item.Unitat ?? string.Empty;
            ws.Cell(rowIndex, 10).Value = FormatData(item.DataActualitzacio);
            rowIndex++;
        }

        ws.Range(1, 1, 1, 10).Style.Font.Bold = true;
        ws.Columns(1, 10).AdjustToContents();

        using var stream = new MemoryStream();
        workbook.SaveAs(stream);
        var base64 = Convert.ToBase64String(stream.ToArray());
        var fileName = $"estadistiques-{DateTime.Now:yyyyMMdd-HHmm}.xlsx";

        await JS.InvokeVoidAsync("downloadBase64File", base64, fileName,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    private PopulationDashboard? ConstruirPopulationDashboard()
    {
        if (dades?.Indicadors == null || !dades.Indicadors.Any())
        {
            return null;
        }

        var total = GetIndicator("f321", "f171", "f74", "f263");
        var homes = GetIndicator("f36", "f318");
        var dones = GetIndicator("f42", "f320");

        if (total == null || homes == null || dones == null)
        {
            return null;
        }

        return new PopulationDashboard(
            BuildScopeData(total, homes, dones, 0),
            BuildScopeData(total, homes, dones, 1),
            BuildScopeData(total, homes, dones, 2));
    }

    private PopulationScopeData BuildScopeData(
        IdescatEmexIndicatorRow total,
        IdescatEmexIndicatorRow homes,
        IdescatEmexIndicatorRow dones,
        int index)
    {
        return new PopulationScopeData(
            Total: GetNumericValue(total, index),
            Homes: GetNumericValue(homes, index),
            Dones: GetNumericValue(dones, index),
            Periode: total.ReferenciaTemporal ?? string.Empty,
            Homes0a14: GetNumericById("f176", index),
            Homes15a64: GetNumericById("f33", index),
            Homes65a84: GetNumericById("f34", index),
            Homes85Mes: GetNumericById("f35", index),
            Dones0a14: GetNumericById("f38", index),
            Dones15a64: GetNumericById("f39", index),
            Dones65a84: GetNumericById("f40", index),
            Dones85Mes: GetNumericById("f41", index));
    }

    private decimal? GetNumericById(string indicatorId, int index)
    {
        var indicator = GetIndicator(indicatorId);
        return indicator == null ? null : GetNumericValue(indicator, index);
    }

    private IdescatEmexIndicatorRow? GetIndicator(params string[] indicatorIds)
    {
        return dades?.Indicadors.FirstOrDefault(i => indicatorIds.Contains(i.IndicadorId, StringComparer.OrdinalIgnoreCase));
    }

    private ThematicDashboard BuildThematicDashboard(
        string key,
        string titol,
        string[] groups,
        (string[] IndicatorIds, string Label)[] definitions,
        bool enableChart)
    {
        var kpis = new List<ThematicKpi>();

        foreach (var definition in definitions)
        {
            var indicador = GetIndicator(definition.IndicatorIds);
            if (indicador == null)
            {
                continue;
            }

            kpis.Add(new ThematicKpi(
                Nom: definition.Label,
                IndicatorId: indicador.IndicadorId,
                MunicipiText: FormatValor(indicador.ValorMunicipiText),
                ComarcaText: FormatValor(indicador.ValorComarcaText),
                CatalunyaText: FormatValor(indicador.ValorCatalunyaText),
                MunicipiValor: indicador.ValorMunicipi,
                ComarcaValor: indicador.ValorComarca,
                CatalunyaValor: indicador.ValorCatalunya,
                Unitat: indicador.Unitat ?? string.Empty,
                Periode: indicador.ReferenciaTemporal ?? string.Empty));
        }

        return new ThematicDashboard(key, titol, groups, kpis, enableChart);
    }

    private ThematicDashboard BuildEconomiaDashboard()
    {
        var dashboard = BuildThematicDashboard("economia", "Treball", new[] { "Treball" }, new[]
        {
            (new[] { "f223" }, "Poblacio activa"),
            (new[] { "f308" }, "Atur registrat"),
            (new[] { "f377", "f363" }, "Afiliacions Seguretat Social")
        }, true);

        var poblacioActiva = GetIndicator("f223");
        var poblacio16Mes = GetIndicator("f224");

        if (poblacioActiva != null && poblacio16Mes != null)
        {
            dashboard.Kpis.Insert(1, new ThematicKpi(
                Nom: "Taxa d'activitat (pob. activa / pob. 16+)",
                IndicatorId: "derived-activity-rate",
                MunicipiText: FormatPercent(CalculateRate(poblacioActiva.ValorMunicipi, poblacio16Mes.ValorMunicipi)),
                ComarcaText: FormatPercent(CalculateRate(poblacioActiva.ValorComarca, poblacio16Mes.ValorComarca)),
                CatalunyaText: FormatPercent(CalculateRate(poblacioActiva.ValorCatalunya, poblacio16Mes.ValorCatalunya)),
                MunicipiValor: CalculateRate(poblacioActiva.ValorMunicipi, poblacio16Mes.ValorMunicipi),
                ComarcaValor: CalculateRate(poblacioActiva.ValorComarca, poblacio16Mes.ValorComarca),
                CatalunyaValor: CalculateRate(poblacioActiva.ValorCatalunya, poblacio16Mes.ValorCatalunya),
                Unitat: "%",
                Periode: poblacioActiva.ReferenciaTemporal ?? string.Empty));
        }

        return dashboard;
    }

    private List<ThematicChartPoint> BuildThematicChartData()
    {
        return activeTabTables
            .SelectMany(t => t.Rows)
            .Where(r => r.ValorMunicipi.HasValue)
            .OrderByDescending(r => r.ValorMunicipi)
            .Take(8)
            .Select(r => new ThematicChartPoint(r.IndicadorNom, r.ValorMunicipi!.Value))
            .ToList();
    }

    private static decimal? CalculateRate(decimal? numerador, decimal? denominador)
    {
        if (!numerador.HasValue || !denominador.HasValue || denominador.Value == 0)
        {
            return null;
        }

        return numerador.Value * 100m / denominador.Value;
    }

    private static string FormatPercent(decimal? value)
    {
        if (!value.HasValue)
        {
            return "-";
        }

        return value.Value.ToString("N1", CultureInfo.GetCultureInfo("ca-ES")) + "%";
    }

    private static decimal? GetNumericValue(IdescatEmexIndicatorRow indicator, int index)
    {
        return index switch
        {
            0 => indicator.ValorMunicipi,
            1 => indicator.ValorComarca,
            2 => indicator.ValorCatalunya,
            _ => null
        };
    }

    private static string FormatValor(string? value)
    {
        if (string.IsNullOrWhiteSpace(value) || value == "_")
        {
            return "-";
        }

        if (decimal.TryParse(value, NumberStyles.Number, CultureInfo.InvariantCulture, out var parsed))
        {
            return parsed.ToString("N2");
        }

        return value;
    }

    private static string FormatNumber(decimal? value)
    {
        if (!value.HasValue)
        {
            return "-";
        }

        return value.Value.ToString("N0", CultureInfo.GetCultureInfo("ca-ES"));
    }

    private static string Percentatge(decimal? value, decimal? total)
    {
        if (!value.HasValue || !total.HasValue || total.Value == 0)
        {
            return "-";
        }

        var pct = value.Value * 100m / total.Value;
        return pct.ToString("N1", CultureInfo.GetCultureInfo("ca-ES")) + "%";
    }

    private static string EscapeCsv(string input)
    {
        if (string.IsNullOrEmpty(input))
        {
            return string.Empty;
        }

        return '"' + input.Replace("\"", "\"\"") + '"';
    }

    private static string FormatData(DateTimeOffset? dataActualitzacio)
    {
        if (!dataActualitzacio.HasValue)
        {
            return "-";
        }

        return dataActualitzacio.Value.ToLocalTime().ToString("dd/MM/yyyy");
    }

