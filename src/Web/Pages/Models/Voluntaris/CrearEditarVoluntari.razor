@page "/voluntaris/nou"
@page "/voluntaris/editar/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using AppAjuntament.Models.Tercers
@using System.Threading
@inject GestorSubvencionsContext Context
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject AppAjuntament.Services.PdfService PdfService
@inject AppAjuntament.Services.DatabaseLoggerService DbLogger
@inject AppAjuntament.Services.MinioStorageService MinioStorage
@implements IDisposable

<div class="screen-header">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/voluntaris">Voluntaris</a></li>
            <li class="breadcrumb-item active">@(Id.HasValue ? "Editar" : "Nou") Voluntari</li>
        </ol>
    </nav>
    <div>
        <button @onclick="Tornar" class="btn btn-outline-secondary me-2">
            <i class="fas fa-arrow-left me-2"></i>Tornar
        </button>
        <button @onclick="Guardar" class="btn btn-primary" disabled="@estaGuardant">
            @if (estaGuardant)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
            }
            else
            {
                <i class="fas fa-save me-2"></i>
            }
            Guardar
        </button>
    </div>
</div>

@if (isLoading)
{
    <div class="row">
        <div class="col-12 text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Carregant...</span>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-lg-8">
            <EditForm Model="voluntari" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />
                
                <!-- Persona (Tercer) -->
                <div class="card mb-4 @(_tercerSeleccionat == null ? "border-warning" : "border-success")">
                    <div class="card-header screen-header">
                        <h5 class="mb-0"><i class="fas fa-id-card me-2"></i>Persona</h5>
                        @if (_tercerSeleccionat != null && !Id.HasValue)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CanviarTercer">
                                <i class="fas fa-exchange-alt me-1"></i>Canviar persona
                            </button>
                        }
                    </div>
                    <div class="card-body">
                        @if (_tercerSeleccionat == null)
                        {
                            @if (!_mostrarFormNouTercer)
                            {
                                <!-- Cerca de Tercer -->
                                <div class="alert alert-warning py-2 mb-3">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    Cal vincular aquest voluntari a una persona existent al registre de tercers.
                                </div>
                                <div class="row g-2">
                                    <div class="col">
                                        <input type="text" class="form-control" placeholder="Cercar per nom, cognoms o DNI..."
                                               @bind="_tercerCerca" @bind:event="oninput" @onkeyup="OnTercerCercaKeyUp" />
                                    </div>
                                    <div class="col-auto">
                                        <button type="button" class="btn btn-outline-primary" @onclick="CercarTercers" disabled="@_cercantTercers">
                                            @if (_cercantTercers) { <span class="spinner-border spinner-border-sm"></span> }
                                            else { <i class="fas fa-search"></i> }
                                        </button>
                                    </div>
                                    <div class="col-auto">
                                        <button type="button" class="btn btn-success" @onclick="MostrarFormNouTercer">
                                            <i class="fas fa-user-plus me-1"></i>Nova persona
                                        </button>
                                    </div>
                                </div>
                                @if (_tercerResultats.Any())
                                {
                                    <div class="list-group mt-2">
                                        @foreach (var t in _tercerResultats)
                                        {
                                            <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                                    @onclick="() => SeleccionarTercer(t)">
                                                <span>
                                                    <strong>@t.NomComplet</strong>
                                                    @if (!string.IsNullOrEmpty(t.DNI)) { <small class="text-muted ms-2">(@t.DNI)</small> }
                                                </span>
                                                <small class="text-muted">@t.Email</small>
                                            </button>
                                        }
                                    </div>
                                }
                                else if (_haFetCerca)
                                {
                                    <div class="d-flex align-items-center gap-2 mt-2">
                                        <span class="text-muted small"><i class="fas fa-info-circle me-1"></i>No s'han trobat tercers amb aquest criteri.</span>
                                        <button type="button" class="btn btn-sm btn-success" @onclick="MostrarFormNouTercer">
                                            <i class="fas fa-user-plus me-1"></i>Crear nova persona
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                <!-- Formulari d'alta ràpida de Tercer -->
                                <div class="border rounded p-3 bg-light">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h6 class="mb-0 text-success"><i class="fas fa-user-plus me-2"></i>Nova persona</h6>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OcultarFormNouTercer">
                                            <i class="fas fa-times me-1"></i>Cancel·lar
                                        </button>
                                    </div>
                                    @if (!string.IsNullOrEmpty(_nouTercerError))
                                    {
                                        <div class="alert alert-danger py-2 mb-3">@_nouTercerError</div>
                                    }
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Nom <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control @(string.IsNullOrWhiteSpace(_nouTercer.Nom) && _nouTercerValidat ? "is-invalid" : "")" 
                                                   @bind="_nouTercer.Nom" placeholder="Nom" />
                                            @if (string.IsNullOrWhiteSpace(_nouTercer.Nom) && _nouTercerValidat)
                                            { <div class="invalid-feedback">El nom és obligatori.</div> }
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label fw-semibold">Cognoms <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control @(string.IsNullOrWhiteSpace(_nouTercer.Cognoms) && _nouTercerValidat ? "is-invalid" : "")" 
                                                   @bind="_nouTercer.Cognoms" placeholder="Cognoms" />
                                            @if (string.IsNullOrWhiteSpace(_nouTercer.Cognoms) && _nouTercerValidat)
                                            { <div class="invalid-feedback">Els cognoms són obligatoris.</div> }
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold">DNI / NIE <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control @(string.IsNullOrWhiteSpace(_nouTercer.DNI) && _nouTercerValidat ? "is-invalid" : "")" 
                                                   @bind="_nouTercer.DNI" placeholder="12345678X" />
                                            @if (string.IsNullOrWhiteSpace(_nouTercer.DNI) && _nouTercerValidat)
                                            { <div class="invalid-feedback">El DNI és obligatori.</div> }
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Email</label>
                                            <input type="email" class="form-control" @bind="_nouTercer.Email" placeholder="correu@exemple.cat" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Mòbil</label>
                                            <input type="tel" class="form-control" @bind="_nouTercer.Telefon" placeholder="6XX XXX XXX" />
                                        </div>
                                        <div class="col-md-12">
                                            <label class="form-label">Població</label>
                                            <input type="text" class="form-control" @bind="_nouTercer.Poblacio" placeholder="Població" />
                                        </div>
                                        <div class="col-md-12">
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" id="autoritzacioVoluntari" @bind="_autoritzacioSignada" />
                                                <label class="form-check-label" for="autoritzacioVoluntari">
                                                    Confirmo que la persona ha signat l'autorització de tractament de dades
                                                    per als serveis de l'Ajuntament. *
                                                </label>
                                            </div>
                                            @if (_nouTercerValidat && !_autoritzacioSignada)
                                            {
                                                <div class="text-danger small mt-1">Cal confirmar-ho per poder crear la persona.</div>
                                            }
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2 mt-3">
                                        <button type="button" class="btn btn-success" @onclick="CrearTercerRapid" disabled="@_guardantNouTercer">
                                            @if (_guardantNouTercer) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                            else { <i class="fas fa-check me-2"></i> }
                                            Crear i seleccionar
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary" @onclick="OcultarFormNouTercer">
                                            Cancel·lar
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <!-- Persona vinculada (lectura) -->
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3"
                                     style="width:48px;height:48px;font-size:1.2rem;flex-shrink:0;">
                                    @(_tercerSeleccionat.Nom.FirstOrDefault())
                                </div>
                                <div>
                                    <div class="fw-bold fs-5">@_tercerSeleccionat.NomComplet</div>
                                    @if (!string.IsNullOrEmpty(_tercerSeleccionat.DNI))
                                    {
                                        <small class="text-muted"><i class="fas fa-id-card me-1"></i>@_tercerSeleccionat.DNI</small>
                                    }
                                    @if (!string.IsNullOrEmpty(_tercerSeleccionat.Email))
                                    {
                                        <small class="text-muted ms-3"><i class="fas fa-envelope me-1"></i>@_tercerSeleccionat.Email</small>
                                    }
                                    @if (!string.IsNullOrEmpty(_tercerSeleccionat.Telefon))
                                    {
                                        <small class="text-muted ms-3"><i class="fas fa-mobile-alt me-1"></i>@_tercerSeleccionat.Telefon</small>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Dades de contacte (específiques del voluntariat) -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-address-book me-2"></i>Dades de Contacte</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Telèfon d'Emergència</label>
                                <InputText @bind-Value="voluntari.TelefonEmergencia" class="form-control" placeholder="Telèfon de contacte en cas d'emergència" />
                                <div class="form-text text-muted">Telèfon alternatiu específic del voluntari.</div>
                            </div>
                        </div>
                    </div>
                </div>

            <!-- Dades del voluntariat -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-hands-helping me-2"></i>Dades del Voluntariat</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label">Àmbits de voluntariat *</label>
                            <div class="row">
                                @foreach (var item in ambitsSeleccionatsList)
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="card border-primary">
                                            <div class="card-body p-3">
                                                <div class="form-check mb-2">
                                                    <InputCheckbox @bind-Value="item.Selected" @onchange="() => OnAmbitSelectionChanged(item)" class="form-check-input" />
                                                    <label class="form-check-label fw-bold">@item.Ambit.Nom</label>
                                                </div>
                                                @if (!string.IsNullOrEmpty(item.Ambit.Descripcio))
                                                {
                                                    <small class="text-muted d-block mb-2">@item.Ambit.Descripcio</small>
                                                }
                                                
                                                @if (item.Selected && subambitsDisponibles.Any(s => s.AmbitVoluntariId == item.Ambit.Id))
                                                {
                                                    var subambitsDelsAmbit = subambitsSeleccionatsList.Where(s => s.Subambit.AmbitVoluntariId == item.Ambit.Id).ToList();
                                                    @if (subambitsDelsAmbit.Any())
                                                    {
                                                        <div class="mt-2">
                                                            <label class="form-label small fw-bold">Subàmbits disponibles (@subambitsDelsAmbit.Count):</label>
                                                            <div class="border p-2" style="max-height: 150px; overflow-y: auto;">
                                                                @foreach (var subItem in subambitsDelsAmbit)
                                                                {
                                                                    <div class="form-check">
                                                                        <InputCheckbox @bind-Value="subItem.Selected" class="form-check-input" />
                                                                        <label class="form-check-label small">@subItem.Subambit.Nom</label>
                                                                        @if (!string.IsNullOrEmpty(subItem.Subambit.Descripcio))
                                                                        {
                                                                            <small class="text-muted d-block ms-3">@subItem.Subambit.Descripcio</small>
                                                                        }
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="mt-2 text-muted small">No hi ha subàmbits disponibles per aquest àmbit</div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (!AmbitsSeleccionats.Any())
                            {
                                <div class="text-danger small">Cal seleccionar almenys un àmbit</div>
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Estat *</label>
                            <InputSelect @bind-Value="voluntari.EstatVoluntariId" class="form-select">
                                <option value="0">Seleccionar estat...</option>
                                @foreach (var estat in estatsDisponibles)
                                {
                                    <option value="@estat.Id">@estat.Nom</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => voluntari.EstatVoluntariId)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Ens *</label>
                            <InputSelect @bind-Value="voluntari.EnsId" class="form-select">
                                <option value="0">Seleccionar ens...</option>
                                @foreach (var ens in ensDisponibles)
                                {
                                    <option value="@ens.Id">@ens.Nom</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => voluntari.EnsId)" />
                        </div>
                        
                        @if (coordinadorsDisponibles.Any())
                        {
                            <div class="col-md-6">
                                <label class="form-label">Coordinador</label>
                                <InputSelect @bind-Value="voluntari.CoordinadorId" class="form-select">
                                    <option value="">Sense coordinador</option>
                                    @foreach (var coordinador in coordinadorsDisponibles)
                                    {
                                        <option value="@coordinador.Id">@coordinador.NomComplet</option>
                                    }
                                </InputSelect>
                            </div>
                        }
                        
                        @if (enllacosDisponibles.Any())
                        {
                            <div class="col-md-6">
                                <label class="form-label">Enllaó amb Ajuntament</label>
                                <InputSelect @bind-Value="voluntari.EnllacAjuntamentId" class="form-select">
                                    <option value="">Sense enllaó</option>
                                    @foreach (var enllac in enllacosDisponibles)
                                    {
                                        <option value="@enllac.Id">@enllac.NomComplet</option>
                                    }
                                </InputSelect>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Informació addicional -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Informació Addicional</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label">Habilitats</label>
                            <InputTextArea @bind-Value="voluntari.Habilitats" class="form-control" rows="3" 
                                          placeholder="Descriure les habilitats i capacitats del voluntari..." />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Disponibilitat</label>
                            <InputTextArea @bind-Value="voluntari.Disponibilitat" class="form-control" rows="2" 
                                          placeholder="Indicar la disponibilitat horària..." />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Observacions</label>
                            <InputTextArea @bind-Value="voluntari.Observacions" class="form-control" rows="3" 
                                          placeholder="Observacions generals..." />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Acord d'Incorporació -->
            @if (Id.HasValue)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="fas fa-file-contract me-2"></i>Acord d'Incorporació</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-check">
                                    <InputCheckbox @bind-Value="voluntari.AcordSignat" class="form-check-input" id="acordSignat" />
                                    <label class="form-check-label" for="acordSignat">Acord signat</label>
                                </div>
                            </div>
                            @if (voluntari.AcordSignat)
                            {
                                <div class="col-md-6">
                                    <label class="form-label">Data de Signatura</label>
                                    <InputDate active @bind-Value="voluntari.DataSignaturaAcord" class="form-control" disabled />
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Estat del voluntari -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-toggle-on me-2"></i>Estat</h5>
                </div>
                <div class="card-body">
                    <div class="form-check">
                        <InputCheckbox @bind-Value="voluntari.Actiu" class="form-check-input" id="actiu" />
                        <label class="form-check-label" for="actiu">
                            Voluntari actiu
                        </label>
                    </div>
                    @if (!voluntari.Actiu && Id.HasValue)
                    {
                        <div class="mt-3">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Data de Baixa</label>
                                    <InputDate @bind-Value="voluntari.DataBaixa" class="form-control" />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label">Motiu de la Baixa</label>
                                    <InputTextArea @bind-Value="voluntari.MotiuBaixa" class="form-control" rows="2" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </EditForm>
    </div>
    
    <!-- Panell lateral amb Informació -->
    <div class="col-lg-4">
        @if (Id.HasValue)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h6 class="mb-0"><i class="fas fa-info me-2"></i>Informació</h6>
                </div>
                <div class="card-body">
                    <small class="text-muted">
                        <strong>Data de creació:</strong> @voluntari.DataIncorporacio.ToString("dd/MM/yyyy")<br />
                        @if (voluntari.Tercer?.DataNaixement.HasValue == true)
                        {
                            <text><strong>Edat:</strong> @voluntari.Edat anys<br /></text>
                        }
                        @if (voluntari.EsCoordinador)
                        {
                            <span class="badge bg-danger">Coordinador</span><br />
                        }
                        @if (voluntari.EsEnllacAjuntament)
                        {
                            <span class="badge bg-success">Enllaó amb Ajuntament</span>
                        }
                    </small>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h6 class="mb-0"><i class="fas fa-paperclip me-2"></i>Documents</h6>
                </div>
                <div class="card-body p-2">
                    <DocumentsPanel EntityType="@DocumentEntityType.Voluntari"
                                    EntityId="@Id"
                                    TramitCodi="VOLUNTARI_ALTA"
                                    AllowCustomType="false" />
                </div>
            </div>
        }
        
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-question-circle me-2"></i>Ajuda</h6>
            </div>
            <div class="card-body">
                <small class="text-muted">
                    <p><strong>Àmbits:</strong> Defineixen l'àmbit d'actuació del voluntari segons les seves funcions.</p>
                    <p><strong>Estats:</strong> Indiquen la situació actual del voluntari en el procés.</p>
                    <p><strong>Coordinador:</strong> Voluntari que coordina a un grup de voluntaris.</p>
                    <p><strong>Enllaó:</strong> Voluntari que fa d'intermediari amb l'ajuntament.</p>
                </small>
            </div>
        </div>
    </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private Voluntari voluntari = new();

    // Selector de Tercer
    private Tercer? _tercerSeleccionat;
    private string _tercerCerca = "";
    private List<Tercer> _tercerResultats = new();
    private bool _cercantTercers = false;
    private bool _haFetCerca = false;

    // Alta ràpida de Tercer
    private bool _mostrarFormNouTercer = false;
    private bool _nouTercerValidat = false;
    private bool _guardantNouTercer = false;
    private bool _autoritzacioSignada = false;
    private string _nouTercerError = "";
    private Tercer _nouTercer = new() { CreatedAt = DateTime.UtcNow, UpdatedAt = DateTime.UtcNow };

    private List<AmbitVoluntari> ambitsDisponibles = new();
    private List<SubambitVoluntari> subambitsDisponibles = new();
    private List<EstatVoluntari> estatsDisponibles = new();
    private List<Ens> ensDisponibles = new();
    private List<Voluntari> coordinadorsDisponibles = new();
    private List<Voluntari> enllacosDisponibles = new();
    private HashSet<int> AmbitsSeleccionats = new();
    private HashSet<int> SubambitsSeleccionats = new();
    private class AmbitSelection
    {
        public AmbitVoluntari Ambit { get; set; }
        public bool Selected { get; set; }
        
        public AmbitSelection(AmbitVoluntari ambit, bool selected)
        {
            Ambit = ambit;
            Selected = selected;
        }
    }
    private List<AmbitSelection> ambitsSeleccionatsList = new();
    private class SubambitSelection
    {
        public SubambitVoluntari Subambit { get; set; }
        public bool Selected { get; set; }
        
        public SubambitSelection(SubambitVoluntari subambit, bool selected)
        {
            Subambit = subambit;
            Selected = selected;
        }
    }
    private List<SubambitSelection> subambitsSeleccionatsList = new();

    private bool estaGuardant = false;
    private bool isLoading = true;
    private bool _disposedValue;
    private CancellationTokenSource _cts = new CancellationTokenSource();



    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Carregar dades de lookup
            await CarregarDadesLookup();

            // Si ós edició, carregar les dades del voluntari
            if (Id.HasValue)
            {
                await CarregarVoluntari();
            }
            else
            {
                // Valors per defecte per a nou voluntari
                voluntari.DataIncorporacio = DateTime.Today;
                voluntari.Actiu = true;
            }

            ambitsSeleccionatsList = ambitsDisponibles.Select(a => new AmbitSelection(a, AmbitsSeleccionats.Contains(a.Id))).ToList();
            ActualitzarSubambitsDisponibles();
            isLoading = false;
        }
        catch (OperationCanceledException)
        {
            // Operació cancelólada
        }
    }

    private void OnAmbitSelectionChanged(AmbitSelection ambitSelection)
    {
        // Actualitzar la selecció d'àmbits
        AmbitsSeleccionats = ambitsSeleccionatsList.Where(x => x.Selected).Select(x => x.Ambit.Id).ToHashSet();
        ActualitzarSubambitsDisponibles();
        StateHasChanged();
    }

    private void ActualitzarSubambitsDisponibles()
    {
        var ambitsSeleccionatsIds = ambitsSeleccionatsList.Where(a => a.Selected).Select(a => a.Ambit.Id).ToHashSet();
        
        // Si no hi ha cap àmbit seleccionat, mostra tots els subàmbits
        // Si hi ha àmbits seleccionats, mostra Només els subàmbits d'aquests àmbits
        subambitsSeleccionatsList = ambitsSeleccionatsIds.Any()
            ? subambitsDisponibles
                .Where(s => ambitsSeleccionatsIds.Contains(s.AmbitVoluntariId))
                .Select(s => new SubambitSelection(s, SubambitsSeleccionats.Contains(s.Id)))
                .ToList()
            : subambitsDisponibles
                .Select(s => new SubambitSelection(s, SubambitsSeleccionats.Contains(s.Id)))
                .ToList();
        
        StateHasChanged();
    }

    private async Task CarregarDadesLookup()
    {
        ambitsDisponibles = await Context.AmbitsVoluntaris
            .Where(a => a.Actiu)
            .OrderBy(a => a.Nom)
            .ToListAsync(_cts.Token);

        subambitsDisponibles = await Context.SubambitsVoluntaris
            .Include(s => s.AmbitVoluntari)
            .Where(s => s.Actiu)
            .OrderBy(s => s.AmbitVoluntari!.Nom)
            .ThenBy(s => s.Nom)
            .ToListAsync(_cts.Token);

        estatsDisponibles = await Context.EstatsVoluntaris
            .Where(e => e.Actiu)
            .OrderBy(e => e.Ordre)
            .ThenBy(e => e.Nom)
            .ToListAsync(_cts.Token);

        ensDisponibles = await Context.Ens
            .OrderBy(e => e.Nom)
            .ToListAsync(_cts.Token);

        // Carregar coordinadors i enllaóos (voluntaris que poden actuar com a tals)
        var voluntarisActius = await Context.Voluntaris
            .Where(v => v.Actiu)
            .Include(v => v.VoluntarisAmbits).ThenInclude(va => va.AmbitVoluntari)
            .ToListAsync(_cts.Token);

        coordinadorsDisponibles = voluntarisActius
            .Where(v => v.VoluntarisAmbits.Any(va => va.AmbitVoluntari?.PotSerCoordinador == true))
            .ToList();

        enllacosDisponibles = voluntarisActius
            .Where(v => v.VoluntarisAmbits.Any(va => va.AmbitVoluntari?.PotSerEnllacAjuntament == true))
            .ToList();
    }

    private async Task CarregarVoluntari()
    {
        if (!Id.HasValue) return;

        var voluntariDB = await Context.Voluntaris
            .AsNoTracking()
            .Include(v => v.VoluntarisAmbits).ThenInclude(va => va.AmbitVoluntari)
            .Include(v => v.VoluntarisAmbits).ThenInclude(va => va.SubambitVoluntari)
            .Include(v => v.EstatVoluntari)
            .Include(v => v.Ens)
            .Include(v => v.Tercer)
            .FirstOrDefaultAsync(v => v.Id == Id.Value, _cts.Token);

        if (voluntariDB != null)
        {
            voluntari = voluntariDB;
            // Carregar Tercer vinculat
            _tercerSeleccionat = voluntariDB.Tercer;
            // Carregar àmbits seleccionats
            AmbitsSeleccionats = voluntari.VoluntarisAmbits
                .Select(va => va.AmbitVoluntariId)
                .ToHashSet();
            // Carregar subàmbits seleccionats
            SubambitsSeleccionats = voluntari.VoluntarisAmbits
                .Where(va => va.SubambitVoluntariId.HasValue)
                .Select(va => va.SubambitVoluntariId!.Value)
                .ToHashSet();
        }
        else
        {
            // Voluntari no trobat, redirigir
            NavigationManager.NavigateTo("/voluntaris");
        }
    }

    private async Task Guardar()
    {
        if (estaGuardant) return;

        estaGuardant = true;
        try
        {
            AmbitsSeleccionats = ambitsSeleccionatsList.Where(x => x.Selected).Select(x => x.Ambit.Id).ToHashSet();
            SubambitsSeleccionats = subambitsSeleccionatsList.Where(x => x.Selected).Select(x => x.Subambit.Id).ToHashSet();

            // Validar que s'ha seleccionat un Tercer
            if (_tercerSeleccionat == null)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Cal vincular la persona (Tercer) abans de guardar el voluntari.");
                return;
            }

            // Vincular Tercer al voluntari
            // Netejar nav property per evitar conflictes EF amb el change tracker
            voluntari.Tercer = null;
            voluntari.TercerId = _tercerSeleccionat.Id;

            if (Id.HasValue)
            {
                // Nullar TOTES les nav properties per evitar que EF recorri el graf
                // i trobi instàncies ja rastrejades (conflicte Identity Map).
                // Els FKs (EnsId, EstatVoluntariId, etc.) es preserven — EF els utilitza per guardar.
                voluntari.EstatVoluntari = null;
                voluntari.Ens = null;
                voluntari.Coordinador = null;
                voluntari.EnllacAjuntament = null;
                voluntari.VoluntarisCoordinats = new List<Voluntari>();
                voluntari.VoluntarisEnllacats = new List<Voluntari>();
                voluntari.VoluntarisAmbits = new List<VoluntariAmbit>();
                voluntari.Activitats = new List<ActitatVoluntari>();
                voluntari.Formacions = new List<FormacioVoluntari>();

                // Detach qualsevol Voluntari amb el mateix Id al tracker
                var trackedEntry = Context.ChangeTracker.Entries<Voluntari>()
                    .FirstOrDefault(e => e.Entity.Id == voluntari.Id);
                if (trackedEntry != null)
                {
                    trackedEntry.State = EntityState.Detached;
                }
                Context.Voluntaris.Update(voluntari);
            }
            else
            {
                // Crear nou voluntari
                Context.Voluntaris.Add(voluntari);
            }

            await Context.SaveChangesAsync(_cts.Token);

            // Actualitzar àmbits seleccionats
            await ActualitzarAmbitsVoluntari(voluntari.Id);

            // Generar PDF si té l'àmbit "Colonies felines"
            if (AmbitsSeleccionats.Contains(ambitsDisponibles.FirstOrDefault(a => a.Nom == "Colonies felines")?.Id ?? 0))
            {
                await JSRuntime.InvokeVoidAsync("open", $"/api/pdf/volunteer-form/{voluntari.Id}", "_blank");
            }

            // Mostrar missatge d'èxit i redirigir
            await JSRuntime.InvokeVoidAsync("alert", "Voluntari guardat correctament!");
            NavigationManager.NavigateTo("/voluntaris");
        }
        catch (OperationCanceledException)
        {
            // Operació cancelólada
        }
        catch (Exception ex)
        {
            await DbLogger.LogErrorAsync($"Error al guardar voluntari {(Id.HasValue ? $"ID={Id.Value}" : "NOU")}", ex, "Guardar", $"VoluntariId={Id?.ToString() ?? "NULL"}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error al guardar: {ex.Message}");
        }
        finally
        {
            estaGuardant = false;
            StateHasChanged();
        }
    }

    private async Task ActualitzarAmbitsVoluntari(int voluntariId)
    {
        // Obtenir totes les assignacions existents
        var assignacionsExistents = await Context.VoluntarisAmbits
            .Where(va => va.VoluntariId == voluntariId)
            .ToListAsync(_cts.Token);

        // Crear llista de combinacions desitjades (àmbit + subàmbit opcional)
        var combinacionsDesitjades = new List<(int AmbitId, int? SubambitId)>();
        
        // Afegir àmbits sense subàmbit
        foreach (var ambitId in AmbitsSeleccionats)
        {
            // Si no hi ha subàmbits seleccionats per aquest àmbit, afegir Només l'àmbit
            var subambitsDelsAmbit = SubambitsSeleccionats
                .Where(s => subambitsDisponibles.FirstOrDefault(sb => sb.Id == s)?.AmbitVoluntariId == ambitId)
                .ToList();
            
            if (!subambitsDelsAmbit.Any())
            {
                combinacionsDesitjades.Add((ambitId, null));
            }
        }
        
        // Afegir subàmbits seleccionats (cada subàmbit implica el seu àmbit)
        foreach (var subambitId in SubambitsSeleccionats)
        {
            var subambit = subambitsDisponibles.FirstOrDefault(s => s.Id == subambitId);
            if (subambit != null)
            {
                combinacionsDesitjades.Add((subambit.AmbitVoluntariId, subambitId));
            }
        }

        // Eliminar assignacions que ja no són desitjades
        var assignacionsAEliminar = assignacionsExistents
            .Where(va => !combinacionsDesitjades.Any(c => c.AmbitId == va.AmbitVoluntariId && c.SubambitId == va.SubambitVoluntariId))
            .ToList();

        if (assignacionsAEliminar.Any())
        {
            Context.VoluntarisAmbits.RemoveRange(assignacionsAEliminar);
        }

        // Afegir noves assignacions
        foreach (var (ambitId, subambitId) in combinacionsDesitjades)
        {
            var assignacioExistent = assignacionsExistents
                .FirstOrDefault(va => va.AmbitVoluntariId == ambitId && va.SubambitVoluntariId == subambitId);
            
            if (assignacioExistent == null)
            {
                var novaAssignacio = new VoluntariAmbit
                {
                    VoluntariId = voluntariId,
                    AmbitVoluntariId = ambitId,
                    SubambitVoluntariId = subambitId,
                    DataAssignacio = DateTime.Now
                };
                Context.VoluntarisAmbits.Add(novaAssignacio);
            }
        }

        await Context.SaveChangesAsync(_cts.Token);
    }

    private void Tornar()
    {
        NavigationManager.NavigateTo("/voluntaris");
    }

    private async Task OnTercerCercaKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CercarTercers();
    }

    private async Task CercarTercers()
    {
        if (string.IsNullOrWhiteSpace(_tercerCerca)) return;
        _cercantTercers = true;
        _haFetCerca = false;
        StateHasChanged();
        try
        {
            var cerca = _tercerCerca.Trim().ToLower();
            _tercerResultats = await Context.Tercers
                .Where(t =>
                    (t.Nom != null && t.Nom.ToLower().Contains(cerca)) ||
                    (t.Cognoms != null && t.Cognoms.ToLower().Contains(cerca)) ||
                    (t.DNI != null && t.DNI.ToLower().Contains(cerca)))
                .OrderBy(t => t.Nom).ThenBy(t => t.Cognoms)
                .Take(10)
                .ToListAsync(_cts.Token);
            _haFetCerca = true;
        }
        catch (OperationCanceledException) { }
        finally
        {
            _cercantTercers = false;
            StateHasChanged();
        }
    }

    private void SeleccionarTercer(Tercer tercer)
    {
        _tercerSeleccionat = tercer;
        voluntari.TercerId = tercer.Id;
        _tercerResultats.Clear();
        _tercerCerca = "";
        _haFetCerca = false;
        StateHasChanged();
    }

    private void CanviarTercer()
    {
        _tercerSeleccionat = null;
        // Netejar FK i nav property perquè EF no restauri la relació anterior al guardar
        voluntari.TercerId = null;
        voluntari.Tercer = null;
        _tercerCerca = "";
        _tercerResultats.Clear();
        _haFetCerca = false;
        _mostrarFormNouTercer = false;
        StateHasChanged();
    }

    private void MostrarFormNouTercer()
    {
        // Pre-omplir el nom si ja s'ha escrit a la cerca
        _nouTercer = new Tercer { CreatedAt = DateTime.UtcNow, UpdatedAt = DateTime.UtcNow };
        if (!string.IsNullOrWhiteSpace(_tercerCerca))
        {
            var parts = _tercerCerca.Trim().Split(' ', 2);
            _nouTercer.Nom = parts[0];
            if (parts.Length > 1) _nouTercer.Cognoms = parts[1];
        }
        _nouTercerError = "";
        _nouTercerValidat = false;
        _autoritzacioSignada = false;
        _mostrarFormNouTercer = true;
        StateHasChanged();
    }

    private void OcultarFormNouTercer()
    {
        _mostrarFormNouTercer = false;
        _nouTercerError = "";
        _nouTercerValidat = false;
        StateHasChanged();
    }

    private async Task CrearTercerRapid()
    {
        _nouTercerValidat = true;
        _nouTercerError = "";

        // Validació mínima
        if (string.IsNullOrWhiteSpace(_nouTercer.Nom) ||
            string.IsNullOrWhiteSpace(_nouTercer.Cognoms) ||
            string.IsNullOrWhiteSpace(_nouTercer.DNI) ||
            !_autoritzacioSignada)
        {
            StateHasChanged();
            return;
        }

        // Comprovar DNI duplicat
        var dniExistent = await Context.Tercers
            .AnyAsync(t => t.DNI == _nouTercer.DNI.Trim(), _cts.Token);
        if (dniExistent)
        {
            _nouTercerError = $"Ja existeix una persona amb el DNI '{_nouTercer.DNI.Trim()}'. Useu la cerca per localitzar-la.";
            StateHasChanged();
            return;
        }

        _guardantNouTercer = true;
        StateHasChanged();
        try
        {
            _nouTercer.Nom     = _nouTercer.Nom.Trim();
            _nouTercer.Cognoms = _nouTercer.Cognoms?.Trim();
            _nouTercer.DNI     = _nouTercer.DNI.Trim().ToUpper();
            _nouTercer.Email   = _nouTercer.Email?.Trim();
            _nouTercer.Telefon = _nouTercer.Telefon?.Trim();
            _nouTercer.Poblacio = _nouTercer.Poblacio?.Trim();
            _nouTercer.AutoritzacioTractamentSignada = true;
            _nouTercer.DataAutoritzacio = DateTime.Now;

            Context.Tercers.Add(_nouTercer);
            await Context.SaveChangesAsync(_cts.Token);

            // Seleccionar automàticament el tercer recièn creat
            SeleccionarTercer(_nouTercer);
            _mostrarFormNouTercer = false;
        }
        catch (Exception ex)
        {
            _nouTercerError = $"Error en crear la persona: {ex.Message}";
        }
        finally
        {
            _guardantNouTercer = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Dispose(true);
        GC.SuppressFinalize(this);
    }

    protected virtual void Dispose(bool disposing)
    {
        if (!_disposedValue)
        {
            if (disposing)
            {
                _cts.Cancel();
                _cts.Dispose();
            }
            _disposedValue = true;
        }
    }
