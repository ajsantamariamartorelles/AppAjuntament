@using AppAjuntament.Models.Voluntariat
@using AppAjuntament.Models.Base
@page "/voluntaris/activitats"
@using AppAjuntament.Models
@using Microsoft.EntityFrameworkCore
@using System.Threading
@inject GestorSubvencionsContext Context
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject AppAjuntament.Services.DatabaseLoggerService DbLogger
@implements IDisposable

<div class="screen-header">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/voluntaris">Voluntaris</a></li>
            <li class="breadcrumb-item active">Activitats</li>
        </ol>
    </nav>
    <div>
        <button @onclick="@(() => NavigationManager.NavigateTo("/voluntaris"))" class="btn btn-outline-secondary me-2">
            <i class="fas fa-arrow-left me-2"></i>Tornar
        </button>
        <button @onclick="NovaActivitat" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Nova Activitat
        </button>
    </div>
</div>

<!-- Filtres -->
<div class="card mb-3 screen-filters-card">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Estat</label>
                <InputSelect class="form-select form-select-sm" @bind-Value="estatSeleccionat">
                    <option value="totes">Totes</option>
                    <option value="actives">Nomós actives</option>
                    <option value="finalitzades">Finalitzades</option>
                </InputSelect>
            </div>
            <div class="col-md-3">
                <label class="form-label">Ens</label>
                <InputSelect class="form-select form-select-sm" @bind-Value="ensSeleccionat">
                    <option value="0">Tots els ens</option>
                    @foreach (var ens in ensDisponibles)
                    {
                        <option value="@ens.Id">@ens.Nom</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-3">
                <label class="form-label">órea</label>
                <InputSelect class="form-select form-select-sm" @bind-Value="areaSeleccionada">
                    <option value="0">Totes les àrees</option>
                    @foreach (var area in areasDisponibles)
                    {
                        <option value="@area.Id">@area.Nom</option>
                    }
                </InputSelect>
            </div>
            <div class="col-md-3">
                <label class="form-label">Cerca</label>
                <div class="input-group input-group-sm">
                    <input type="text" class="form-control" placeholder="Nom de l'activitat..." @bind="textoCerca" @onkeypress="OnKeyPress">
                    <button class="btn btn-outline-secondary" type="button" @onclick="Cercar">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Llista d'activitats -->
<div class="row">
    @if (activitats?.Any() == true)
    {
        @foreach (var activitat in activitats)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 @(activitat.Activa ? "" : "border-secondary")">
                    <div class="card-header screen-header">
                        <h6 class="mb-0">@activitat.Nom</h6>
                        @if (activitat.Activa)
                        {
                            @if (activitat.DataFi.HasValue && activitat.DataFi.Value < DateTime.Today)
                            {
                                <span class="badge bg-warning">Finalitzada</span>
                            }
                            else if (activitat.DataInici <= DateTime.Today)
                            {
                                <span class="badge bg-success">En curs</span>
                            }
                            else
                            {
                                <span class="badge bg-info">Programada</span>
                            }
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactiva</span>
                        }
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(activitat.Descripcio))
                        {
                            <p class="card-text small text-muted mb-2">@activitat.Descripcio</p>
                        }
                        
                        <div class="small mb-2">
                            <div><i class="fas fa-calendar me-1"></i><strong>Inici:</strong> @activitat.DataInici.ToString("dd/MM/yyyy")</div>
                            @if (activitat.DataFi.HasValue)
                            {
                                <div><i class="fas fa-calendar-check me-1"></i><strong>Fi:</strong> @activitat.DataFi.Value.ToString("dd/MM/yyyy")</div>
                            }
                            @if (!string.IsNullOrEmpty(activitat.Ubicacio))
                            {
                                <div><i class="fas fa-map-marker-alt me-1"></i><strong>Ubicació:</strong> @activitat.Ubicacio</div>
                            }
                            <div><i class="fas fa-building me-1"></i><strong>Ens:</strong> @activitat.Ens?.Nom</div>
                            @if (activitat.Area != null)
                            {
                                <div><i class="fas fa-layer-group me-1"></i><strong>órea:</strong> @activitat.Area.Nom</div>
                            }
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge bg-primary">
                                @activitat.Voluntaris.Count(av => av.Actiu) voluntaris
                            </span>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="btn-group btn-group-sm w-100">
                            <button @onclick="() => EditarActivitat(activitat.Id)" class="btn btn-outline-primary">
                                <i class="fas fa-edit me-1"></i>Editar
                            </button>
                            <button @onclick="() => GestionarVoluntaris(activitat.Id)" class="btn btn-outline-info">
                                <i class="fas fa-users me-1"></i>Voluntaris
                            </button>
                            <div class="btn-group">
                                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#" @onclick="() => CanviarEstatActivitat(activitat)">
                                        <i class="fas fa-toggle-@(activitat.Activa ? "off" : "on") me-2"></i>@(activitat.Activa ? "Desactivar" : "Activar")
                                    </a></li>
                                    @if (activitat.Voluntaris.Count == 0)
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" href="#" @onclick="() => EliminarActivitat(activitat.Id)">
                                            <i class="fas fa-trash me-2"></i>Eliminar
                                        </a></li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="text-center py-5">
                <i class="fas fa-calendar-check fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">No s'han trobat activitats</h5>
                <p class="text-muted">Creeu la primera activitat per comenóar a gestionar els voluntaris</p>
                <button @onclick="NovaActivitat" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Crear Activitat
                </button>
            </div>
        </div>
    }
</div>

<!-- Modal per crear/editar activitat -->
@if (mostrarModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @if (activitatEditant == null)
                        {
                            <text><i class="fas fa-plus me-2"></i>Nova Activitat</text>
                        }
                        else
                        {
                            <text><i class="fas fa-edit me-2"></i>Editar Activitat</text>
                        }
                    </h5>
                    <button type="button" class="btn-close" @onclick="TancarModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="activitatModel" OnValidSubmit="GuardarActivitat">
                        <DataAnnotationsValidator />
                        
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label">Nom de l'Activitat *</label>
                                <InputText @bind-Value="activitatModel.Nom" class="form-control" />
                                <ValidationMessage For="@(() => activitatModel.Nom)" />
                            </div>
                            
                            <div class="col-md-12">
                                <label class="form-label">Descripció</label>
                                <InputTextArea @bind-Value="activitatModel.Descripcio" class="form-control" rows="3" />
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label">Data d'Inici *</label>
                                <InputDate @bind-Value="activitatModel.DataInici" class="form-control" />
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label">Data de Fi</label>
                                <InputDate @bind-Value="activitatModel.DataFi" class="form-control" />
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label">Ens *</label>
                                <InputSelect @bind-Value="activitatModel.EnsId" class="form-select">
                                    <option value="0">Seleccionar ens...</option>
                                    @foreach (var ens in ensDisponibles)
                                    {
                                        <option value="@ens.Id">@ens.Nom</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => activitatModel.EnsId)" />
                            </div>
                            
                            <div class="col-md-6">
                                <label class="form-label">órea</label>
                                <InputSelect @bind-Value="activitatModel.AreaId" class="form-select">
                                    <option value="">Seleccionar órea...</option>
                                    @foreach (var area in areasDisponibles)
                                    {
                                        <option value="@area.Id">@area.Nom</option>
                                    }
                                </InputSelect>
                            </div>
                            
                            <div class="col-md-12">
                                <label class="form-label">Ubicació</label>
                                <InputText @bind-Value="activitatModel.Ubicacio" class="form-control" />
                            </div>
                            
                            <div class="col-md-12">
                                <div class="form-check">
                                    <InputCheckbox @bind-Value="activitatModel.Activa" class="form-check-input" id="activaModal" />
                                    <label class="form-check-label" for="activaModal">
                                        Activitat activa
                                    </label>
                                </div>
                            </div>
                        </div>
                        
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="TancarModal">Cancelólar</button>
                            <button type="submit" class="btn btn-primary" disabled="@estaGuardant">
                                @if (estaGuardant)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                @if (activitatEditant == null)
                                {
                                    <text><i class="fas fa-plus me-2"></i>Crear</text>
                                }
                                else
                                {
                                    <text><i class="fas fa-save me-2"></i>Guardar</text>
                                }
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Activitat> activitats = new();
    private List<Ens> ensDisponibles = new();
    private List<Area> areasDisponibles = new();
    
    private Activitat activitatModel = new();
    private Activitat? activitatEditant = null;
    
    private bool mostrarModal = false;
    private bool estaGuardant = false;
    private bool _disposedValue;
    private CancellationTokenSource _cts = new CancellationTokenSource();

    // Filtres
    private string estatSeleccionat
    {
        get => _estatSeleccionat;
        set
        {
            if (_estatSeleccionat != value)
            {
                _estatSeleccionat = value;
                if (_inicialitzat) _ = CarregarActivitats();
            }
        }
    }
    private string _estatSeleccionat = "totes";

    private int ensSeleccionat
    {
        get => _ensSeleccionat;
        set
        {
            if (_ensSeleccionat != value)
            {
                _ensSeleccionat = value;
                if (_inicialitzat) _ = CarregarActivitats();
            }
        }
    }
    private int _ensSeleccionat = 0;

    private int areaSeleccionada
    {
        get => _areaSeleccionada;
        set
        {
            if (_areaSeleccionada != value)
            {
                _areaSeleccionada = value;
                if (_inicialitzat) _ = CarregarActivitats();
            }
        }
    }
    private int _areaSeleccionada = 0;

    private string textoCerca = "";
    private bool _inicialitzat = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Carregar dades de lookup
            ensDisponibles = await Context.Ens
                .OrderBy(e => e.Nom)
                .ToListAsync(_cts.Token);

            areasDisponibles = await Context.Arees
                .OrderBy(a => a.Nom)
                .ToListAsync(_cts.Token);

            await CarregarActivitats();
            _inicialitzat = true;
        }
        catch (OperationCanceledException)
        {
            // Operació cancelólada
        }
    }

    private async Task CarregarActivitats()
    {
        if (_disposedValue) return;

        try
        {
            var query = Context.Activitats
                .Include(a => a.Ens)
                .Include(a => a.Area)
                .Include(a => a.Voluntaris)
                .AsQueryable();

            // Aplicar filtres
            if (estatSeleccionat == "actives")
                query = query.Where(a => a.Activa);
            else if (estatSeleccionat == "finalitzades")
                query = query.Where(a => a.DataFi.HasValue && a.DataFi.Value < DateTime.Today);

            if (ensSeleccionat != 0)
                query = query.Where(a => a.EnsId == ensSeleccionat);

            if (areaSeleccionada != 0)
                query = query.Where(a => a.AreaId == areaSeleccionada);

            if (!string.IsNullOrWhiteSpace(textoCerca))
            {
                var cerca = textoCerca.ToLower();
                query = query.Where(a => a.Nom != null && a.Nom.ToLower().Contains(cerca));
            }

            activitats = await query
                .OrderByDescending(a => a.DataInici)
                .ToListAsync(_cts.Token);

            if (!_disposedValue)
                StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // Operació cancelólada
        }
    }

    private async Task OnKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Cercar();
        }
    }

    private async Task Cercar()
    {
        await CarregarActivitats();
    }

    private void NovaActivitat()
    {
        activitatEditant = null;
        activitatModel = new Activitat
        {
            DataInici = DateTime.Today,
            Activa = true,
            DataCreacio = DateTime.Now
        };
        mostrarModal = true;
    }

    private void EditarActivitat(int id)
    {
        var activitat = activitats.First(a => a.Id == id);
        activitatEditant = activitat;
        activitatModel = new Activitat
        {
            Id = activitat.Id,
            Nom = activitat.Nom,
            Descripcio = activitat.Descripcio,
            DataInici = activitat.DataInici,
            DataFi = activitat.DataFi,
            EnsId = activitat.EnsId,
            AreaId = activitat.AreaId,
            Ubicacio = activitat.Ubicacio,
            Activa = activitat.Activa,
            DataCreacio = activitat.DataCreacio
        };
        mostrarModal = true;
    }

    private async Task GuardarActivitat()
    {
        if (estaGuardant) return;

        estaGuardant = true;
        try
        {
            if (activitatEditant == null)
            {
                // Nova activitat
                Context.Activitats.Add(activitatModel);
            }
            else
            {
                // Editar activitat existent
                var activitatDB = await Context.Activitats.FindAsync(activitatEditant.Id);
                if (activitatDB != null)
                {
                    activitatDB.Nom = activitatModel.Nom;
                    activitatDB.Descripcio = activitatModel.Descripcio;
                    activitatDB.DataInici = activitatModel.DataInici;
                    activitatDB.DataFi = activitatModel.DataFi;
                    activitatDB.EnsId = activitatModel.EnsId;
                    activitatDB.AreaId = activitatModel.AreaId;
                    activitatDB.Ubicacio = activitatModel.Ubicacio;
                    activitatDB.Activa = activitatModel.Activa;
                }
            }

            await Context.SaveChangesAsync(_cts.Token);
            await CarregarActivitats();
            TancarModal();
        }
        catch (OperationCanceledException)
        {
            // Operació cancelólada
        }
        catch (Exception ex)
        {
            await DbLogger.LogErrorAsync($"Error al guardar activitat: {activitatEditant?.Nom ?? "NOVA"}", ex, "GuardarActivitat", $"ActivitatId={activitatEditant?.Id.ToString() ?? "NULL"}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error al guardar: {ex.Message}");
        }
        finally
        {
            estaGuardant = false;
            StateHasChanged();
        }
    }

    private void TancarModal()
    {
        mostrarModal = false;
        activitatEditant = null;
    }

    private async Task CanviarEstatActivitat(Activitat activitat)
    {
        try
        {
            activitat.Activa = !activitat.Activa;
            Context.Activitats.Update(activitat);
            await Context.SaveChangesAsync(_cts.Token);
            await CarregarActivitats();
        }
        catch (OperationCanceledException)
        {
            // Operació cancelólada
        }
        catch (Exception ex)
        {
            await DbLogger.LogErrorAsync($"Error al canviar estat activitat ID={activitat.Id}", ex, "CanviarEstatActivitat", $"ActivitatId={activitat.Id}, NouEstat={activitat.Activa}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error al canviar l'estat: {ex.Message}");
        }
    }

    private async Task EliminarActivitat(int id)
    {
        var confirmat = await JSRuntime.InvokeAsync<bool>("confirm", "Esteu segur que voleu eliminar aquesta activitat?");
        if (!confirmat) return;

        try
        {
            var activitat = await Context.Activitats.FindAsync(id);
            if (activitat != null)
            {
                Context.Activitats.Remove(activitat);
                await Context.SaveChangesAsync(_cts.Token);
                await CarregarActivitats();
            }
        }
        catch (OperationCanceledException)
        {
            // Operació cancelólada
        }
        catch (Exception ex)
        {
            await DbLogger.LogErrorAsync($"Error al eliminar activitat ID={id}", ex, "EliminarActivitat", $"ActivitatId={id}");
            await JSRuntime.InvokeVoidAsync("alert", $"Error al eliminar: {ex.Message}");
        }
    }

    private void GestionarVoluntaris(int activitatId)
    {
        NavigationManager.NavigateTo($"/voluntaris/activitats/{activitatId}/voluntaris");
    }

    public void Dispose()
    {
        Dispose(true);
        GC.SuppressFinalize(this);
    }

    protected virtual void Dispose(bool disposing)
    {
        if (!_disposedValue)
        {
            if (disposing)
            {
                _cts.Cancel();
                _cts.Dispose();
            }
            _disposedValue = true;
        }
    }
}