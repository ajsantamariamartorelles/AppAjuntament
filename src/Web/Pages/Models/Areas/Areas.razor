@page "/arees"
@using Microsoft.EntityFrameworkCore
@inject NavigationManager NavigationManager
@inject GestorSubvencionsContext Context

<div class="screen-header">
    <h3 class="screen-title"><i class="fas fa-layer-group me-2"></i>Llistat d'Àrees</h3>
    <button @onclick="NovaArea" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>Nova Àrea
    </button>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        @if (arees.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Id</th>
                            <th>Nom</th>
                            <th>Ens</th>
                            <th class="text-end">Accions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var area in arees)
                        {
                            <tr>
                                <td>@area.Id</td>
                                <td>@area.Nom</td>
                                <td>@(area.Ens?.Nom ?? "Sense ens")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button @onclick="() => EditarArea(area.Id)" class="btn btn-outline-primary" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button @onclick="() => EliminarArea(area.Id)" class="btn btn-outline-danger" title="Eliminar">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">
                No hi ha àrees disponibles.
            </div>
        }
    </div>
</div>

@code {
    private List<Area> arees = new();
    private List<Ens> ensList = new();

    protected override async Task OnInitializedAsync()
    {
        arees = await Context.Arees.Include(a => a.Ens).ToListAsync();
        ensList = await Context.Ens.ToListAsync();
    }

    private void NovaArea()
    {
        NavigationManager.NavigateTo("/arees/nova");
    }

    private void EditarArea(int id)
    {
        NavigationManager.NavigateTo($"/arees/editar/{id}");
    }

    private async Task EliminarArea(int id)
    {
        var area = await Context.Arees.FindAsync(id);
        if (area != null)
        {
            Context.Arees.Remove(area);
            await Context.SaveChangesAsync();
            arees = await Context.Arees.Include(a => a.Ens).ToListAsync();
        }
    }
}