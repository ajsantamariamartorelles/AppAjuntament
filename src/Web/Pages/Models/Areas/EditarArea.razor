@page "/arees/editar/{id:int}"
@using Microsoft.EntityFrameworkCore
@inject GestorSubvencionsContext Context
@inject NavigationManager NavigationManager

<div class="screen-header">
    <h3 class="screen-title"><i class="fas fa-layer-group me-2"></i>Editar Àrea</h3>
    <button type="button" @onclick="Cancelar" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Tornar
    </button>
</div>

<EditForm Model="@area" OnValidSubmit="ActualitzarArea">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="screen-edit-grid">
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">Dades de l'Àrea</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label>Nom</label>
                    <InputText @bind-Value="area.Nom" class="form-control" />
                </div>

                <div class="mb-0">
                    <label>Ens</label>
                    <InputSelect @bind-Value="area.EnsId" class="form-control">
                        <option value="">Selecciona un ens</option>
                        @foreach (var ens in ensList)
                        {
                            <option value="@ens.Id">@ens.Nom</option>
                        }
                    </InputSelect>
                </div>
            </div>
        </div>

        <div class="screen-sidebar screen-sidebar-sticky">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <strong>Accions</strong>
                </div>
                <div class="card-body d-grid gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>Actualitzar
                    </button>
                    <button type="button" @onclick="Cancelar" class="btn btn-outline-secondary">Cancel·lar</button>
                </div>
            </div>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public int Id { get; set; }

    private Area area = new();
    private List<Ens> ensList = new();

    protected override async Task OnInitializedAsync()
    {
        area = (await Context.Arees.FindAsync(Id))!;
        ensList = await Context.Ens.ToListAsync();
    }

    private async Task ActualitzarArea()
    {
        Context.Arees.Update(area);
        await Context.SaveChangesAsync();
        NavigationManager.NavigateTo("/arees");
    }

    private void Cancelar()
    {
        NavigationManager.NavigateTo("/arees");
    }
}