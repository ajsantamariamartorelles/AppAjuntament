    // ===== MÈTODES PER A LA IMPORTACIÓ =====

    private void MostrarDialegImportacio()
    {
        if (_disposedValue) return;
        
        mostrarDialegImportacio = true;
        fitxerSeleccionat = null;
        fitxerCarregat = null;
        resultatImportacio = null;
        StateHasChanged();
    }

    private void TancarDialegImportacio()
    {
        if (_disposedValue) return;
        
        mostrarDialegImportacio = false;
        fitxerSeleccionat = null;
        fitxerCarregat = null;
        resultatImportacio = null;
        StateHasChanged();
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        if (_disposedValue) return;
        
        fitxerCarregat = e.File;
        fitxerSeleccionat = e.File.Name;
        StateHasChanged();
    }

    private async Task ProcessarImportacio()
    {
        if (_disposedValue || fitxerCarregat == null) return;
        if (anySeleccionat == 0) return; // Seguretat addicional
        
        processantImportacio = true;
        StateHasChanged();

        try
        {
            // Crear carpeta temporal si no existeix
            var tempPath = Path.Combine(Environment.ContentRootPath, "temp");
            if (!Directory.Exists(tempPath))
            {
                Directory.CreateDirectory(tempPath);
            }

            // Guardar fitxer temporalment amb l'extensió correcta
            var extensio = Path.GetExtension(fitxerCarregat.Name);
            var tempFilePath = Path.Combine(tempPath, $"import_{Guid.NewGuid()}{extensio}");
            
            using (var stream = new FileStream(tempFilePath, FileMode.Create))
            {
                await fitxerCarregat.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(stream); // 10MB màxim
            }

            // Processar la importació
            var importador = new ImportadorSubvencions(ContextFactory, DbLogger);
            resultatImportacio = await importador.ImportarCSV(tempFilePath, anySeleccionat);

            // Esborrar fitxer temporal
            if (File.Exists(tempFilePath))
            {
                File.Delete(tempFilePath);
            }

            // Recarregar subvencions
            await CarregarSubvencions();
        }
        catch (Exception ex)
        {
            await DbLogger.LogErrorAsync($"Error processant importació de subvencions: {fitxerCarregat?.Name}", ex, "ProcessarImportacio", $"FileName={fitxerCarregat?.Name}");
            
            if (!_disposedValue)
            {
                try
                {
                    await JSRuntime.InvokeVoidAsync("alert", $"Error en processar la importació: {ex.Message}");
                }
                catch
                {
                    // Si falla el JSRuntime, ignorar
                }
            }
        }
        finally
        {
            if (!_disposedValue)
            {
                processantImportacio = false;
                StateHasChanged();
            }
        }
    }

    private string ObtenirAnySeleccionat()
    {
        if (anySeleccionat == 0) return "(no seleccionat)";
        var anyObj = anysDisponibles.FirstOrDefault(a => a.Id == anySeleccionat);
        return anyObj?.Any.ToString() ?? "(desconegut)";
    }

    private string GetImportBadgeClass(string? estatNom)
    {
        if (_disposedValue || string.IsNullOrEmpty(estatNom)) return "bg-danger";
        
        var estatLower = estatNom.ToLower();
        
        // Groc per estats pendents
        if (estatLower.Contains("pendent"))
            return "bg-warning";
        
        // Verd per estats aprovats/finalitzats
        if (estatLower.Contains("justificada") || 
            estatLower.Contains("finalitzada") || 
            estatLower.Contains("aprovada"))
            return "bg-success";
        
        // Vermell per la resta
        return "bg-danger";
    }

    private string? GetEstatNom(int subvencioId)
    {
        if (_disposedValue) return null;
        
        if (estatEditatDict.TryGetValue(subvencioId, out var estatId) && int.TryParse(estatId, out var id))
        {
            return estatsDisponibles.FirstOrDefault(e => e.Id == id)?.Nom ?? "";
        }
        
        var subvencio = subvencions.FirstOrDefault(s => s.Id == subvencioId);
        return subvencio?.Estat?.Nom ?? "";
    }

    public void Dispose()
    {
        Dispose(true);
        GC.SuppressFinalize(this);
    }

    protected virtual void Dispose(bool disposing)
    {
        if (!_disposedValue)
        {
            _disposedValue = true;

            if (disposing)
            {
                // Cancel·lar totes les operacions async pendents
                try
                {
                    _cts.Cancel();
                }
                catch (ObjectDisposedException)
                {
                    // Ja disposat; no cal fer res.
                }
                
                // Netejar els diccionaris
                estatEditatDict.Clear();
                estatCanviatDict.Clear();
                estatOriginalDict.Clear();
            }
        }
    }
