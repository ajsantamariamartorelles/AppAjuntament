@using AppAjuntament.Shared
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <Authorizing>
            <p role="status">Comprovant autorització…</p>
                </Authorizing>
                <NotAuthorized>
                    <LayoutView Layout="@null">
                        <div class="container py-5 text-center">
                            <div class="alert alert-warning d-inline-block text-start">
                                <i class="fas fa-lock me-2"></i>
                                No tens permisos per veure aquesta pàgina.
                            </div>
                            <div class="mt-3">
                                <a class="btn btn-primary" href="/Auth/Login">Inicia sessió</a>
                            </div>
                        </div>
                        <script>window.location.href='/Auth/Login';</script>
                    </LayoutView>
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
