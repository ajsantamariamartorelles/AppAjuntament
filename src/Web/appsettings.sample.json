{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DatabaseLogging": {
    "ProductionLevel": "Fatal",
    "DevelopmentLevel": "Debug"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=your-db-host;Database=your-database;User=your-user;Password=your-password;"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "your-tenant-domain",
    "TenantId": "00000000-0000-0000-0000-000000000000",
    "ClientId": "11111111-1111-1111-1111-111111111111",
    "ClientSecret": "replace-with-your-client-secret",
    "CallbackPath": "/signin-oidc"
  },
  "MinIO": {
    "Endpoint": "localhost:9000",
    "AccessKey": "replace-with-access-key",
    "SecretKey": "replace-with-secret-key",
    "BucketName": "your-bucket-name",
    "Secure": false
  },
  "Ajuntament": {
    "CodiINE6": "000000",
    "CodiDiba": "00000",
    "CodiEns": "0000000000",
    "NomMunicipi": "Your Municipality",
    "NomInstitucio": "Your Institution"
  },
  "AppBaseUrl": "https://your-app.example.com",
  "Authorization": {
    "Groups": {
      "GroupAccess1": "00000000-0000-0000-0000-000000000000",
      "GroupAccess2": "11111111-1111-1111-1111-111111111111"
    }
  },
  "CursetsJwt": {
    "Issuer": "AppAjuntament.Cursets",
    "Audience": "AppAjuntament.Cursets.Clients",
    "SigningKey": "replace-with-a-random-secret-of-at-least-32-characters",
    "ExpirationMinutes": 480
  }
}
